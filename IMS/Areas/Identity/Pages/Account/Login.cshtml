@page
@model LoginModel
@using Microsoft.EntityFrameworkCore
@inject IMS.Data.ApplicationDbContext DbContext

@{
    var settings = await DbContext.StoreSettings.FirstOrDefaultAsync();
    var storeName = settings?.StoreName ?? "نظام إدارة الصيدلية";
    ViewData["Title"] = "تسجيل الدخول";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @storeName</title>
    <link rel="stylesheet" href="~/lib/fonts/tajawal/tajawal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.rtl.min.css" asp-append-version="true" />
    <style>
        :root {
            --primary-color: #2E8B57; /* Medical Green */
            --primary-light: #4FC3F7; /* Light Blue */
            --primary-dark: #1e5c3a;
            --accent-color: #4FC3F7;
            --success-color: #2ecc71;
            --light-bg: #f4f7f6;
            --dark-text: #2c3e50;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Tajawal', sans-serif;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            direction: rtl;
            text-align: right;
            padding: 20px;
        }

        .login-container {
            background: white;
            border-radius: 24px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15);
            overflow: hidden;
            max-width: 1000px;
            width: 100%;
            display: flex;
            min-height: 600px;
            border: 1px solid rgba(0,0,0,0.05);
        }

        .login-left {
            flex: 1;
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
            padding: 60px 40px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            color: white;
            position: relative;
            overflow: hidden;
        }

        .login-left::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.05) 1px, transparent 1px);
            background-size: 40px 40px;
            animation: moveBackground 30s linear infinite;
        }

        @@keyframes moveBackground {
            0% { transform: translate(0, 0); }
            100% { transform: translate(40px, 40px); }
        }

        .login-left-content {
            position: relative;
            z-index: 1;
            text-align: center;
        }

        .login-logo {
            width: 130px;
            height: 130px;
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(10px);
            border: 2px solid rgba(255, 255, 255, 0.3);
            border-radius: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 35px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
            transform: rotate(-10deg);
            transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .login-logo:hover {
            transform: rotate(0deg) scale(1.05);
        }

        .login-logo i {
            font-size: 65px;
            color: white;
            text-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }

        .login-left h1 {
            font-size: 2.8rem;
            font-weight: 900;
            margin-bottom: 20px;
            letter-spacing: -0.5px;
        }

        .login-left p {
            font-size: 1.15rem;
            opacity: 0.9;
            line-height: 1.7;
            max-width: 300px;
            margin: 0 auto;
        }

        .features {
            margin-top: 50px;
            text-align: right;
            width: 100%;
        }

        .feature-item {
            display: flex;
            align-items: center;
            margin-bottom: 25px;
            gap: 20px;
            background: rgba(255, 255, 255, 0.08);
            padding: 15px;
            border-radius: 18px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            transition: all 0.3s ease;
        }

        .feature-item:hover {
            background: rgba(255, 255, 255, 0.12);
            transform: translateX(-5px);
        }

        .feature-icon {
            width: 45px;
            height: 45px;
            background: rgba(255, 255, 255, 0.2);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            flex-shrink: 0;
        }

        .login-right {
            flex: 1.1;
            padding: 70px 60px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            background: white;
        }

        .login-header {
            text-align: center;
            margin-bottom: 45px;
        }

        .login-header h2 {
            color: var(--dark-text);
            font-size: 2.2rem;
            font-weight: 800;
            margin-bottom: 12px;
            letter-spacing: -0.5px;
        }

        .login-header p {
            color: #64748b;
            font-size: 1.05rem;
        }

        .form-group {
            margin-bottom: 28px;
        }

        .form-label {
            display: block;
            color: #475569;
            font-weight: 700;
            margin-bottom: 12px;
            font-size: 0.95rem;
        }

        .form-control-wrapper {
            position: relative;
        }

        .form-control-icon {
            position: absolute;
            left: 18px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 18px;
            transition: color 0.3s ease;
        }

        .form-control {
            width: 100%;
            padding: 16px 50px 16px 16px;
            border: 2px solid #f1f5f9;
            border-radius: 16px;
            font-size: 1rem;
            transition: all 0.3s ease;
            background: #f8fafc;
            color: var(--dark-text);
            font-weight: 600;
        }

        .form-control:focus {
            outline: none;
            border-color: var(--primary-color);
            background: white;
            box-shadow: 0 0 0 4px rgba(46, 139, 87, 0.1);
        }

        .form-control:focus + .form-control-icon {
            color: var(--primary-color);
        }

        .form-check {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 30px;
        }

        .form-check-input {
            width: 20px;
            height: 20px;
            cursor: pointer;
            border: 2px solid #cbd5e1;
            border-radius: 6px;
        }

        .form-check-input:checked {
            background-color: var(--primary-color);
            border-color: var(--primary-color);
        }

        .form-check-label {
            color: #475569;
            font-weight: 600;
            cursor: pointer;
        }

        .btn-login {
            width: 100%;
            padding: 18px;
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
            color: white;
            border: none;
            border-radius: 16px;
            font-size: 1.15rem;
            font-weight: 800;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 10px 25px rgba(46, 139, 87, 0.25);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
        }

        .btn-login:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 30px rgba(46, 139, 87, 0.35);
        }

        .btn-login:active {
            transform: translateY(-1px);
        }

        .alert {
            padding: 18px;
            border-radius: 16px;
            margin-bottom: 30px;
            display: flex;
            align-items: center;
            gap: 15px;
            border: none;
            font-weight: 600;
        }

        .alert-danger {
            background: #fff1f2;
            color: #e11d48;
            border: 1px solid #ffe4e6;
        }

        /* Responsive */
        @@media (max-width: 992px) {
            .login-container {
                flex-direction: column;
                max-width: 550px;
            }
            .login-left {
                padding: 50px 30px;
            }
            .login-right {
                padding: 50px 40px;
            }
            .features {
                display: none;
            }
        }

        @@media (max-width: 576px) {
            .login-container {
                border-radius: 0;
            }
            body {
                padding: 0;
            }
            .login-right {
                padding: 40px 25px;
            }
            .login-left h1 {
                font-size: 2.2rem;
            }
        }

        /* Loading Animation */
        .btn-login.loading {
            pointer-events: none;
            opacity: 0.85;
        }

        .btn-login.loading i {
            animation: spin 0.8s linear infinite;
        }

        @@keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
    </style>
</head>
<body>
    <div class="login-container shadow-2xl">
        <!-- Left Side (Branding & Features) -->
        <div class="login-left">
            <div class="login-left-content">
                <div class="login-logo">
                    <i class="fas fa-prescription-bottle-medical"></i>
                </div>
                <h1>@storeName</h1>
                <p>نظام ذكي وشامل لإدارة عمليات الصيدلية والمخازن الطبية</p>
                
                <div class="features">
                    <div class="feature-item">
                        <div class="feature-icon">
                            <i class="fas fa-microscope"></i>
                        </div>
                        <div>
                            <strong class="d-block mb-1">تحليلات دقيقة</strong>
                            <p style="font-size: 0.9rem; opacity: 0.8; margin: 0;">تقارير ذكية للمبيعات والأرباح اليومية</p>
                        </div>
                    </div>
                    <div class="feature-item">
                        <div class="feature-icon">
                            <i class="fas fa-capsules"></i>
                        </div>
                        <div>
                            <strong class="d-block mb-1">إدارة الأدوية</strong>
                            <p style="font-size: 0.9rem; opacity: 0.8; margin: 0;">تنبيهات تاريخ الانتهاء ومستوى المخزون</p>
                        </div>
                    </div>
                    <div class="feature-item">
                        <div class="feature-icon">
                            <i class="fas fa-file-prescription"></i>
                        </div>
                        <div>
                            <strong class="d-block mb-1">الوصفات الطبية</strong>
                            <p style="font-size: 0.9rem; opacity: 0.8; margin: 0;">تنظيم متكامل للوصفات وشركات التأمين</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Side (Login Form) -->
        <div class="login-right">
            <div class="login-header">
                <h2>مرحباً بك مجدداً</h2>
                <p>يرجى إدخال بياناتك للوصول إلى النظام</p>
            </div>

            <form id="account" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger shadow-sm">
                        <i class="fas fa-circle-exclamation fs-4"></i>
                        <span>@Model.ErrorMessage</span>
                    </div>
                }

                <div class="form-group">
                    <label asp-for="Input.Email" class="form-label">البريد الإلكتروني</label>
                    <div class="form-control-wrapper">
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" 
                               placeholder="example@pharmacy.com" />
                        <span class="form-control-icon"><i class="fas fa-envelope"></i></span>
                    </div>
                    <span asp-validation-for="Input.Email" class="text-danger small mt-1"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.Password" class="form-label">كلمة المرور</label>
                    <div class="form-control-wrapper">
                        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" 
                               placeholder="••••••••" type="password" />
                        <span class="form-control-icon"><i class="fas fa-lock"></i></span>
                    </div>
                    <span asp-validation-for="Input.Password" class="text-danger small mt-1"></span>
                </div>

                <div class="form-check">
                    <input class="form-check-input" type="checkbox" asp-for="Input.RememberMe" id="rememberMe" />
                    <label class="form-check-label" for="rememberMe">
                        تذكر بيانات الدخول
                    </label>
                </div>

                <button id="login-submit" type="submit" class="btn-login">
                    <i class="fas fa-right-to-bracket"></i> تسجيل الدخول
                </button>

                <div class="login-footer-links">
                    <div class="forgot-password">
                        <a id="forgot-password" asp-area="Identity" asp-page="/Account/ForgotPassword">نسيت كلمة المرور؟</a>
                    </div>
                    <div class="register-link">
                        ليس لديك حساب؟
                        <a asp-area="Identity" asp-page="/Account/Register" asp-route-returnUrl="@Model.ReturnUrl">إنشاء حساب جديد</a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Add loading animation on submit
        document.getElementById('account').addEventListener('submit', function() {
            const btn = document.getElementById('login-submit');
            btn.classList.add('loading');
            btn.innerHTML = '<i class="fas fa-spinner"></i> جاري التحقق...';
        });

        // Soft interaction for inputs
        const inputs = document.querySelectorAll('.form-control');
        inputs.forEach(input => {
            input.addEventListener('focus', function() {
                this.closest('.form-control-wrapper').style.transform = 'translateY(-2px)';
            });
            input.addEventListener('blur', function() {
                this.closest('.form-control-wrapper').style.transform = 'translateY(0)';
            });
        });
    </script>
</body>
</html>
