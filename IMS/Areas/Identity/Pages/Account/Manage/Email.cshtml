@page
@model EmailModel
@{
    ViewData["Title"] = "البريد الإلكتروني";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<div class="mb-4">
    <h3 class="fw-bold text-primary">@ViewData["Title"]</h3>
    <p class="text-muted">أدر عنوان البريد الإلكتروني الخاص بحسابك</p>
</div>

<partial name="_StatusMessage" for="StatusMessage" />

<form id="email-form" method="post">
    <div asp-validation-summary="All" class="text-danger mb-4" role="alert"></div>
    
    <div class="row g-4">
        <div class="col-md-12">
            <div class="form-group mb-4">
                <label asp-for="Email" class="form-label fw-bold mb-2">البريد الحالي</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 rounded-start-3">
                        <i class="fas fa-envelope text-muted"></i>
                    </span>
                    <input asp-for="Email" class="form-control identity-form-control border-start-0 @(Model.IsEmailConfirmed ? "is-valid" : "")" disabled />
                    @if (Model.IsEmailConfirmed)
                    {
                        <span class="input-group-text bg-white border-start-0 rounded-end-3 text-success">
                            <i class="fas fa-check-circle"></i>
                        </span>
                    }
                    else
                    {
                        <span class="input-group-text bg-white border-start-0 rounded-end-3 text-warning">
                            <i class="fas fa-circle-exclamation"></i>
                        </span>
                    }
                </div>
                @if (!Model.IsEmailConfirmed)
                {
                    <button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail" class="btn btn-link text-primary p-0 mt-2 fw-bold">إرسال بريد التحقق</button>
                }
            </div>

            <div class="form-group mb-4">
                <label asp-for="Input.NewEmail" class="form-label fw-bold mb-2">البريد الجديد</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 rounded-start-3">
                        <i class="fas fa-envelope-open text-muted"></i>
                    </span>
                    <input asp-for="Input.NewEmail" class="form-control identity-form-control border-start-0 rounded-end-3" autocomplete="email" aria-required="true" placeholder="أدخل البريد الإلكتروني الجديد..." />
                </div>
                <span asp-validation-for="Input.NewEmail" class="text-danger small mt-1 d-block"></span>
            </div>
        </div>

        <div class="col-12 mt-4">
            <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" class="identity-btn-primary px-5">
                <i class="fas fa-sync me-2"></i> تغيير البريد الإلكتروني
            </button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
