@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "تغيير كلمة المرور";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="mb-4">
    <h3 class="fw-bold text-primary">@ViewData["Title"]</h3>
    <p class="text-muted">قم بتأمين حسابك باستخدام كلمة مرور قوية</p>
</div>

<partial name="_StatusMessage" for="StatusMessage" />

<form id="change-password-form" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-4" role="alert"></div>
    
    <div class="row g-4">
        <div class="col-md-12">
            <div class="form-group mb-4">
                <label asp-for="Input.OldPassword" class="form-label fw-bold mb-2">كلمة المرور الحالية</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 rounded-start-3">
                        <i class="fas fa-lock-open text-muted"></i>
                    </span>
                    <input asp-for="Input.OldPassword" class="form-control identity-form-control border-start-0 rounded-end-3" autocomplete="current-password" aria-required="true" placeholder="أدخل كلمة المرور الحالية..." />
                </div>
                <span asp-validation-for="Input.OldPassword" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Input.NewPassword" class="form-label fw-bold mb-2">كلمة المرور الجديدة</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 rounded-start-3">
                        <i class="fas fa-lock text-muted"></i>
                    </span>
                    <input asp-for="Input.NewPassword" class="form-control identity-form-control border-start-0 rounded-end-3" autocomplete="new-password" aria-required="true" placeholder="أدخل كلمة المرور الجديدة..." />
                </div>
                <span asp-validation-for="Input.NewPassword" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Input.ConfirmPassword" class="form-label fw-bold mb-2">تأكيد كلمة المرور الجديدة</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 rounded-start-3">
                        <i class="fas fa-shield-check text-muted"></i>
                    </span>
                    <input asp-for="Input.ConfirmPassword" class="form-control identity-form-control border-start-0 rounded-end-3" autocomplete="new-password" aria-required="true" placeholder="تأكيد كلمة المرور الجديدة..." />
                </div>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small mt-1 d-block"></span>
            </div>
        </div>

        <div class="col-12 mt-4">
            <button type="submit" class="identity-btn-primary px-5">
                <i class="fas fa-key me-2"></i> تحديث كلمة المرور
            </button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
