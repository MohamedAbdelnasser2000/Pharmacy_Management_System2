@page
@model ForgotPasswordModel
@using Microsoft.EntityFrameworkCore
@inject IMS.Data.ApplicationDbContext DbContext
@{
    var settings = await DbContext.StoreSettings.FirstOrDefaultAsync();
    var storeName = settings?.StoreName ?? "نظام إدارة الصيدلية";
    ViewData["Title"] = "نسيت كلمة المرور";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @storeName</title>
    <link rel="stylesheet" href="~/lib/fonts/tajawal/tajawal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.rtl.min.css" asp-append-version="true" />
    <style>
        :root {
            --primary-color: #2E8B57;
            --primary-dark: #1e5c3a;
            --accent-color: #4FC3F7;
            --dark-text: #1e293b;
        }

        body {
            font-family: 'Tajawal', sans-serif;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            direction: rtl;
            padding: 20px;
        }

        .forgot-container {
            background: white;
            border-radius: 24px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15);
            max-width: 450px;
            width: 100%;
            padding: 50px 40px;
            text-align: center;
            border: 1px solid rgba(0,0,0,0.05);
            position: relative;
            overflow: hidden;
        }

        .forgot-container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 6px;
            background: linear-gradient(90deg, var(--primary-color), var(--accent-color));
        }

        .forgot-icon {
            width: 90px;
            height: 90px;
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
            border-radius: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 25px;
            color: white;
            font-size: 45px;
            box-shadow: 0 10px 20px rgba(46, 139, 87, 0.2);
        }

        h2 {
            color: var(--dark-text);
            font-size: 2rem;
            font-weight: 800;
            margin-bottom: 15px;
            letter-spacing: -0.5px;
        }

        p {
            color: #64748b;
            margin-bottom: 35px;
            line-height: 1.6;
        }

        .form-control {
            width: 100%;
            padding: 16px;
            border: 2px solid #f1f5f9;
            border-radius: 14px;
            font-size: 1rem;
            transition: all 0.3s ease;
            background: #f8fafc;
            color: var(--dark-text);
            font-weight: 600;
            text-align: center;
            margin-bottom: 25px;
        }

        .form-control:focus {
            outline: none;
            border-color: var(--primary-color);
            background: white;
            box-shadow: 0 0 0 4px rgba(46, 139, 87, 0.1);
        }

        .btn-submit {
            width: 100%;
            padding: 16px;
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
            color: white;
            border: none;
            border-radius: 14px;
            font-size: 1.15rem;
            font-weight: 800;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 10px 25px rgba(46, 139, 87, 0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
        }

        .btn-submit:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 30px rgba(46, 139, 87, 0.3);
        }

        .back-link {
            margin-top: 35px;
            padding-top: 25px;
            border-top: 1px dashed #e2e8f0;
        }

        .back-link a {
            color: var(--primary-color);
            text-decoration: none;
            font-weight: 800;
            transition: all 0.3s ease;
        }

        .back-link a:hover {
            color: var(--primary-dark);
            text-decoration: underline;
        }

        .text-danger {
            color: #ef4444;
            font-size: 0.85rem;
            margin-top: -15px;
            margin-bottom: 15px;
            display: block;
            font-weight: 600;
        }
    </style>
</head>
<body>
    <div class="forgot-container">
        <div class="forgot-icon">
            <i class="fas fa-lock-open"></i>
        </div>
        <h2>نسيت كلمة المرور؟</h2>
        <p>لا تقلق، أدخل بريدك الإلكتروني وسنرسل لك رابطاً آمناً لإعادة تعيين كلمة مرورك.</p>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <input asp-for="Input.Email" class="form-control" placeholder="البريد الإلكتروني المسجل" autocomplete="email" />
            <span asp-validation-for="Input.Email" class="text-danger"></span>
            
            <button type="submit" class="btn-submit">
                <i class="fas fa-paper-plane"></i> إرسال رابط التعيين
            </button>
        </form>

        <div class="back-link">
            <a asp-page="./Login">
                <i class="fas fa-arrow-right"></i> العودة لتسجيل الدخول
            </a>
        </div>
    </div>
</body>
</html>
