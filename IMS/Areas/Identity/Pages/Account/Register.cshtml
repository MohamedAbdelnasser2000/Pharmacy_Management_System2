@page
@model RegisterModel
@using Microsoft.EntityFrameworkCore
@inject IMS.Data.ApplicationDbContext DbContext
@{
    var settings = await DbContext.StoreSettings.FirstOrDefaultAsync();
    var storeName = settings?.StoreName ?? "نظام إدارة الصيدلية";
    ViewData["Title"] = "إنشاء حساب جديد";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @storeName</title>
    <link rel="stylesheet" href="~/lib/fonts/tajawal/tajawal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.rtl.min.css" asp-append-version="true" />
    <style>
        :root {
            --primary-color: #2E8B57;
            --primary-dark: #1e5c3a;
            --accent-color: #4FC3F7;
            --light-bg: #f8fafc;
            --dark-text: #1e293b;
        }

        body {
            font-family: 'Tajawal', sans-serif;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            direction: rtl;
            padding: 20px;
        }

        .register-container {
            background: white;
            border-radius: 24px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15);
            max-width: 500px;
            width: 100%;
            padding: 50px 45px;
            border: 1px solid rgba(0,0,0,0.05);
            position: relative;
            overflow: hidden;
        }

        .register-container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 6px;
            background: linear-gradient(90deg, var(--primary-color), var(--accent-color));
        }

        .register-header {
            text-align: center;
            margin-bottom: 40px;
        }

        .register-logo {
            width: 90px;
            height: 90px;
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
            border-radius: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 25px;
            color: white;
            font-size: 45px;
            box-shadow: 0 10px 20px rgba(46, 139, 87, 0.2);
            transform: rotate(-5deg);
        }

        .register-header h2 {
            color: var(--dark-text);
            font-size: 2.2rem;
            font-weight: 800;
            margin-bottom: 12px;
            letter-spacing: -0.5px;
        }

        .register-header p {
            color: #64748b;
            font-size: 1.05rem;
        }

        .form-group {
            margin-bottom: 24px;
        }

        .form-label {
            display: block;
            color: #475569;
            font-weight: 700;
            margin-bottom: 10px;
            font-size: 0.95rem;
        }

        .form-control-wrapper {
            position: relative;
        }

        .form-control-icon {
            position: absolute;
            left: 18px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 18px;
            transition: all 0.3s ease;
        }

        .form-control {
            width: 100%;
            padding: 14px 45px 14px 15px;
            border: 2px solid #f1f5f9;
            border-radius: 14px;
            font-size: 1rem;
            transition: all 0.3s ease;
            background: #f8fafc;
            color: var(--dark-text);
            font-weight: 600;
        }

        .form-control:focus {
            outline: none;
            border-color: var(--primary-color);
            background: white;
            box-shadow: 0 0 0 4px rgba(46, 139, 87, 0.1);
        }

        .form-control:focus + .form-control-icon {
            color: var(--primary-color);
        }

        .btn-register {
            width: 100%;
            padding: 16px;
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
            color: white;
            border: none;
            border-radius: 14px;
            font-size: 1.15rem;
            font-weight: 800;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-top: 15px;
            box-shadow: 0 10px 25px rgba(46, 139, 87, 0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
        }

        .btn-register:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 30px rgba(46, 139, 87, 0.3);
        }

        .login-link {
            text-align: center;
            margin-top: 35px;
            padding-top: 25px;
            border-top: 1px dashed #e2e8f0;
            color: #64748b;
        }

        .login-link a {
            color: var(--primary-color);
            text-decoration: none;
            font-weight: 800;
            margin-right: 5px;
            transition: all 0.3s ease;
        }

        .login-link a:hover {
            color: var(--primary-dark);
            text-decoration: underline;
        }

        .text-danger {
            color: #ef4444;
            font-size: 0.85rem;
            margin-top: 6px;
            display: block;
            font-weight: 600;
        }

        @@media (max-width: 576px) {
            .register-container {
                padding: 40px 25px;
                border-radius: 0;
            }
            body { padding: 0; }
        }
    </style>
</head>
<body>
    <div class="register-container">
        <div class="register-header">
            <div class="register-logo">
                <i class="fas fa-user-plus"></i>
            </div>
            <h2>إنشاء حساب جديد</h2>
            <p>انضم إلى منصة إدارة الصيدلية المتكاملة</p>
        </div>

        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <div class="form-group">
                <label asp-for="Input.FullName" class="form-label">الاسم بالكامل</label>
                <div class="form-control-wrapper">
                    <input asp-for="Input.FullName" class="form-control" placeholder="أدخل اسمك الثلاثي" />
                    <span class="form-control-icon"><i class="fas fa-user"></i></span>
                </div>
                <span asp-validation-for="Input.FullName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.Email" class="form-label">البريد الإلكتروني</label>
                <div class="form-control-wrapper">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" 
                           placeholder="example@pharmacy.com" />
                    <span class="form-control-icon"><i class="fas fa-envelope"></i></span>
                </div>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.Password" class="form-label">كلمة المرور</label>
                <div class="form-control-wrapper">
                    <input asp-for="Input.Password" class="form-control" type="password" autocomplete="new-password" 
                           placeholder="كلمة مرور قوية (6 رموز على الأقل)" />
                    <span class="form-control-icon"><i class="fas fa-lock"></i></span>
                </div>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.ConfirmPassword" class="form-label">تأكيد كلمة المرور</label>
                <div class="form-control-wrapper">
                    <input asp-for="Input.ConfirmPassword" class="form-control" type="password" autocomplete="new-password" 
                           placeholder="أعد إدخال كلمة المرور" />
                    <span class="form-control-icon"><i class="fas fa-shield-check"></i></span>
                </div>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <button id="registerSubmit" type="submit" class="btn-register">
                <i class="fas fa-user-plus"></i> إنشاء الحساب
            </button>

            <div class="login-link">
                لديك حساب بالفعل؟
                <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">تسجيل الدخول</a>
            </div>
        </form>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>