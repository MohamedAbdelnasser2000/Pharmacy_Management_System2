@model List<IMS.Models.ECommerceOrder>
@{
    ViewData["Title"] = "إدارة طلبات المتجر";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1><i class="fas fa-shopping-bag text-primary"></i> إدارة طلبات المتجر الإلكتروني</h1>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                <i class="fas fa-check-circle"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Stats Cards -->
        <div class="row g-3 mb-4">
            <div class="col-lg-3 col-md-6">
                <div class="small-box bg-info">
                    <div class="inner">
                        <h3>@ViewBag.TotalOrders</h3>
                        <p>إجمالي الطلبات</p>
                    </div>
                    <div class="icon"><i class="fas fa-shopping-bag"></i></div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="small-box bg-warning">
                    <div class="inner">
                        <h3>@ViewBag.PendingOrders</h3>
                        <p>طلبات قيد الانتظار</p>
                    </div>
                    <div class="icon"><i class="fas fa-clock"></i></div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="small-box bg-primary">
                    <div class="inner">
                        <h3>@ViewBag.ProcessingOrders</h3>
                        <p>قيد التجهيز</p>
                    </div>
                    <div class="icon"><i class="fas fa-cog"></i></div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="small-box bg-success">
                    <div class="inner">
                        <h3>@(((decimal)ViewBag.TotalRevenue).ToString("N2"))</h3>
                        <p>إيرادات الطلبات المكتملة</p>
                    </div>
                    <div class="icon"><i class="fas fa-money-bill-wave"></i></div>
                </div>
            </div>
        </div>

        <!-- Filters -->
        <div class="card card-outline card-primary mb-3">
            <div class="card-body">
                <form asp-area="ECommerce" asp-controller="ECommerceOrders" asp-action="Index" method="get" class="row g-2 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label">بحث</label>
                        <input type="text" name="search" class="form-control" value="@ViewBag.CurrentSearch" placeholder="رقم الطلب، اسم العميل، الهاتف..." />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">الحالة</label>
                        <select name="status" class="form-select">
                            <option value="">الكل</option>
                            <option value="Pending" selected="@(ViewBag.CurrentStatus == "Pending")">قيد الانتظار</option>
                            <option value="Processing" selected="@(ViewBag.CurrentStatus == "Processing")">قيد التجهيز</option>
                            <option value="Shipped" selected="@(ViewBag.CurrentStatus == "Shipped")">تم الشحن</option>
                            <option value="Delivered" selected="@(ViewBag.CurrentStatus == "Delivered")">تم التوصيل</option>
                            <option value="Cancelled" selected="@(ViewBag.CurrentStatus == "Cancelled")">ملغي</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary w-100"><i class="fas fa-search"></i> بحث</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Orders Table -->
        <div class="card">
            <div class="card-body table-responsive p-0">
                <table class="table table-hover text-nowrap">
                    <thead class="bg-light">
                        <tr>
                            <th>رقم الطلب</th>
                            <th>العميل</th>
                            <th>الهاتف</th>
                            <th>المنتجات</th>
                            <th>الإجمالي</th>
                            <th>الحالة</th>
                            <th>التاريخ</th>
                            <th>إجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td><strong>@order.OrderNumber</strong></td>
                                <td>@order.CustomerName</td>
                                <td>@order.CustomerPhone</td>
                                <td><span class="badge bg-info">@order.OrderItems.Count منتج</span></td>
                                <td><strong>@order.GrandTotal.ToString("N2") ج.م</strong></td>
                                <td>
                                    <span class="badge @IMS.Models.ECommerceOrderStatus.GetBadgeClass(order.Status) rounded-pill">
                                        @IMS.Models.ECommerceOrderStatus.GetArabicName(order.Status)
                                    </span>
                                </td>
                                <td>@order.OrderDate.ToString("yyyy/MM/dd HH:mm")</td>
                                <td>
                                    <a asp-area="ECommerce" asp-controller="ECommerceOrders" asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-eye"></i> تفاصيل
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Pagination -->
        @if ((int)ViewBag.TotalPages > 1)
        {
            <nav class="mt-3">
                <ul class="pagination justify-content-center">
                    @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(i == (int)ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-area="ECommerce" asp-controller="ECommerceOrders" asp-action="Index"
                               asp-route-page="@i" asp-route-status="@ViewBag.CurrentStatus" asp-route-search="@ViewBag.CurrentSearch">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</section>
