@model IEnumerable<IMS.Models.ECommerceOrder>
@using IMS.Models
@{
    ViewData["Title"] = "طلباتي";
    Layout = "_ECommerceLayout";
}

<div class="container py-5">
    <div class="mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Dashboard" class="text-decoration-none">لوحة التحكم</a></li>
                <li class="breadcrumb-item active" aria-current="page">طلباتي</li>
            </ol>
        </nav>
        <h2 class="fw-bold"><i class="fas fa-shopping-bag text-primary me-2"></i> تاريخ الطلبات</h2>
        <p class="text-muted">عرض جميع طلباتك السابقة وحالاتها الحالية</p>
    </div>

    <div class="ec-card overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="bg-light">
                    <tr>
                        <th class="px-4 py-3">رقم الطلب</th>
                        <th class="px-4 py-3">التاريخ</th>
                        <th class="px-4 py-3">العنوان</th>
                        <th class="px-4 py-3">المجموع</th>
                        <th class="px-4 py-3 text-center">الحالة</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var order in Model)
                        {
                            <tr>
                                <td class="px-4 py-3 fw-bold">#@order.OrderNumber</td>
                                <td class="px-4 py-3 text-muted">@order.OrderDate.ToString("yyyy/MM/dd HH:mm")</td>
                                <td class="px-4 py-3">
                                    <small class="d-block text-truncate" style="max-width: 250px;">@order.ShippingAddress</small>
                                </td>
                                <td class="px-4 py-3 fw-bold text-primary">@order.GrandTotal.ToString("N2") ج.م</td>
                                <td class="px-4 py-3 text-center">
                                    <span class="badge @ECommerceOrderStatus.GetBadgeClass(order.Status) px-3 py-2 rounded-pill">
                                        @ECommerceOrderStatus.GetArabicName(order.Status)
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                <p class="text-muted">لا توجد طلبات لعرضها.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .ec-card {
            background: white;
            border: 1px solid #f1f5f9;
            border-radius: 20px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        }
    </style>
}
