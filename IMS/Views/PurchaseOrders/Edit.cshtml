@model IMS.Models.PurchaseOrder
@{
    ViewData["Title"] = "تعديل طلب شراء الأدوية";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0"><i class="fas fa-edit text-info"></i> تعديل طلب شراء الأدوية #@Model.Id</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">الرئيسية</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">طلبات الشراء</a></li>
                    <li class="breadcrumb-item active">تعديل</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-gradient-info text-white">
                <h5 class="card-title mb-0"><i class="fas fa-pen"></i> تعديل البيانات</h5>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="OrderDate" />
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    
                    <div class="form-group">
                        <label asp-for="SupplierId" class="control-label">المورد</label>
                        <select asp-for="SupplierId" class="form-control" asp-items="ViewBag.SupplierId">
                            <option value="">-- اختر المورد --</option>
                        </select>
                        <span asp-validation-for="SupplierId" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="TotalAmount" class="control-label">المبلغ الإجمالي</label>
                                <input asp-for="TotalAmount" class="form-control" type="number" step="0.01" />
                                <span asp-validation-for="TotalAmount" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="PaidAmount" class="control-label">المبلغ المدفوع</label>
                                <input asp-for="PaidAmount" class="form-control" type="number" step="0.01" readonly />
                                <small class="text-muted">استخدم صفحة التفاصيل لإضافة دفعات</small>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="Status" class="control-label">الحالة</label>
                        <select asp-for="Status" class="form-control">
                            <option value="جديد">جديد</option>
                            <option value="قيد التوريد">قيد التوريد</option>
                            <option value="مستلم">مستلم</option>
                        </select>
                    </div>

                    <div class="form-group mt-3 text-end">
                        <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
                        <button type="submit" class="btn btn-primary">حفظ التعديلات</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
