@model IMS.Models.PurchaseOrder
@{
    ViewData["Title"] = "تفاصيل طلب شراء الأدوية";
    var remaining = Model.TotalAmount - Model.PaidAmount;
    var warehouses = ViewBag.Warehouses as IEnumerable<IMS.Models.Warehouse> ?? Enumerable.Empty<IMS.Models.Warehouse>();
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0"><i class="fas fa-file-alt text-primary"></i> تفاصيل طلب شراء الأدوية #@Model.Id</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">الرئيسية</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">طلبات الشراء</a></li>
                    <li class="breadcrumb-item active">تفاصيل</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <div class="row">
            <div class="col-md-8">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-gradient-primary text-white">
                        <h5 class="card-title mb-0"><i class="fas fa-info-circle"></i> معلومات طلب شراء الأدوية</h5>
                    </div>
                    <div class="card-body">
                        <dl class="row">
                            <dt class="col-sm-3">رقم الأمر</dt>
                            <dd class="col-sm-9">#@Model.Id</dd>

                            <dt class="col-sm-3">المورد</dt>
                            <dd class="col-sm-9">
                                <a asp-controller="Suppliers" asp-action="Details" asp-route-id="@Model.SupplierId">
                                    @Model.Supplier?.Name
                                </a>
                            </dd>

                            <dt class="col-sm-3">تاريخ الأمر</dt>
                            <dd class="col-sm-9">@Model.OrderDate.ToString("yyyy/MM/dd HH:mm")</dd>

                            <dt class="col-sm-3">الحالة</dt>
                            <dd class="col-sm-9">
                                @if (Model.Status == "جديد")
                                {
                                    <span class="badge bg-primary">@Model.Status</span>
                                }
                                else if (Model.Status == "قيد التوريد")
                                {
                                    <span class="badge bg-warning">@Model.Status</span>
                                }
                                else if (Model.Status == "مستلم")
                                {
                                    <span class="badge bg-success">@Model.Status</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@Model.Status</span>
                                }
                            </dd>
                        </dl>

                        <hr />

                        <h6 class="text-primary">عناصر أمر الشراء</h6>
                        @if (Model.PurchaseOrderItems != null && Model.PurchaseOrderItems.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th>المنتج</th>
                                            <th>الكمية</th>
                                            <th>السعر</th>
                                            <th>الإجمالي</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.PurchaseOrderItems)
                                        {
                                            <tr>
                                                <td>@item.Product?.Name</td>
                                                <td>@item.Quantity</td>
                                                <td>@item.UnitPrice.ToString("C")</td>
                                                <td>@((item.Quantity * item.UnitPrice).ToString("C"))</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted">لا توجد عناصر في هذا الأمر</p>
                        }

                        @if (Model.Payments != null && Model.Payments.Any())
                        {
                            <hr />
                            <h6 class="text-primary">سجل المدفوعات</h6>
                            <div class="table-responsive">
                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th>التاريخ</th>
                                            <th>المبلغ</th>
                                            <th>طريقة الدفع</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var payment in Model.Payments.OrderByDescending(p => p.PaymentDate))
                                        {
                                            <tr>
                                                <td>@payment.PaymentDate.ToString("yyyy/MM/dd HH:mm")</td>
                                                <td>@payment.Amount.ToString("C")</td>
                                                <td>@payment.Method</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                    <div class="card-footer text-end">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">تعديل</a>
                        <a asp-action="Index" class="btn btn-outline-secondary">عودة</a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card">
                    <div class="card-header bg-info text-white">
                        <h5 class="card-title mb-0">الملخص المالي</h5>
                    </div>
                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-6">المبلغ الإجمالي:</dt>
                            <dd class="col-6 text-end fw-bold">@Model.TotalAmount.ToString("C")</dd>

                            <dt class="col-6">المدفوع:</dt>
                            <dd class="col-6 text-end text-success">@Model.PaidAmount.ToString("C")</dd>

                            <dt class="col-6">المتبقي:</dt>
                            <dd class="col-6 text-end @(remaining > 0 ? "text-danger" : "text-success") fw-bold">
                                @remaining.ToString("C")
                            </dd>
                        </dl>
                    </div>
                </div>

                @if (Model.Status == "جديد")
                {
                    <div class="card mt-3">
                        <div class="card-header bg-success text-white">
                            <h5 class="card-title mb-0">استلام البضاعة</h5>
                        </div>
                        <div class="card-body">
                            @if (Model.PurchaseOrderItems != null && Model.PurchaseOrderItems.Any())
                            {
                                @if (warehouses.Any())
                                {
                                    <form asp-action="Receive" asp-route-id="@Model.Id" method="post">
                                        @Html.AntiForgeryToken()
                                        <p class="mb-3">حدد المستودع لكل صنف قبل التأكيد</p>
                                        @foreach (var item in Model.PurchaseOrderItems)
                                        {
                                            <div class="mb-3">
                                                <label class="form-label d-block">@item.Product?.Name <span class="text-muted">(@item.Quantity)</span></label>
                                                @{ var defaultExpiry = item.Product?.ExpiryDate?.ToString("yyyy-MM-dd"); }
                                                <div class="row g-2">
                                                    <div class="col-md-6">
                                                        <select name="itemWarehouseIds[@item.Id]" class="form-select" required>
                                                            <option value="">اختر المستودع</option>
                                                            @foreach (var warehouse in warehouses)
                                                            {
                                                                <option value="@warehouse.Id">@warehouse.Name</option>
                                                            }
                                                        </select>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <input type="date" name="itemExpiryDates[@item.Id]" class="form-control" value="@defaultExpiry" required />
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        <button type="submit" class="btn btn-success w-100">
                                            <i class="fas fa-check"></i> تأكيد الاستلام
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <div class="alert alert-warning mb-0">
                                        لا توجد مستودعات متاحة للاستلام.
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="alert alert-info mb-0">
                                    لا توجد عناصر مسجلة في هذا الأمر.
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (remaining > 0)
                {
                    <div class="card mt-3">
                        <div class="card-header">
                            <h5 class="card-title mb-0">إضافة دفعة</h5>
                        </div>
                        <div class="card-body">
                            <form asp-action="AddPayment" method="post">
                                <input type="hidden" name="id" value="@Model.Id" />
                                <div class="form-group">
                                    <label>المبلغ</label>
                                    <input type="number" name="amount" class="form-control" step="0.01" max="@remaining" required />
                                </div>
                                <div class="form-group">
                                    <label>طريقة الدفع</label>
                                    <select name="method" class="form-control" required>
                                        <option value="نقدي">نقدي</option>
                                        <option value="شيك">شيك</option>
                                        <option value="تحويل بنكي">تحويل بنكي</option>
                                    </select>
                                </div>
                                <button type="submit" class="btn btn-primary w-100 mt-2">
                                    <i class="fas fa-money-bill"></i> إضافة دفعة
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>
