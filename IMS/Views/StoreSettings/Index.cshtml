@model IMS.Models.StoreSettings
@{
    ViewData["Title"] = "إعدادات الصيدلية";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0"><i class="fas fa-cog text-secondary"></i> إعدادات الصيدلية</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">الرئيسية</a></li>
                    <li class="breadcrumb-item active">الإعدادات</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="row">
            <div class="col-md-8 mx-auto">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-gradient-secondary text-white d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0">
                            <i class="fas fa-clinic-medical me-2"></i>معلومات الصيدلية
                        </h5>
                        <a asp-action="Edit" class="btn btn-light btn-sm">
                            <i class="fas fa-edit me-1"></i>تعديل
                        </a>
                    </div>
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-md-12">
                                <div class="info-box bg-light">
                                    <div class="info-box-content">
                                        @if (!string.IsNullOrEmpty(Model.LogoUrl))
                                        {
                                            <div class="text-center mb-3">
                                                <img src="@Model.LogoUrl" alt="شعار المخزن" style="max-height: 120px; max-width: 100%; object-fit: contain;" class="img-thumbnail" />
                                            </div>
                                        }
                                        
                                        <h4 class="text-primary mb-3">
                                            <i class="fas fa-building me-2"></i>@Model.StoreName
                                        </h4>
                                        
                                        <div class="row">
                                            <div class="col-md-6 mb-3">
                                                <p class="mb-2">
                                                    <i class="fas fa-phone text-success me-2"></i>
                                                    <strong>التليفون:</strong> 
                                                    <span class="text-muted">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "غير محدد" : Model.PhoneNumber)</span>
                                                </p>
                                                @if (!string.IsNullOrEmpty(Model.PhoneNumber2))
                                                {
                                                    <p class="mb-2">
                                                        <i class="fas fa-phone text-success me-2"></i>
                                                        <strong>تليفون إضافي:</strong> 
                                                        <span class="text-muted">@Model.PhoneNumber2</span>
                                                    </p>
                                                }
                                            </div>
                                            
                                            <div class="col-md-6 mb-3">
                                                <p class="mb-2">
                                                    <i class="fas fa-envelope text-info me-2"></i>
                                                    <strong>البريد الإلكتروني:</strong> 
                                                    <span class="text-muted">@(string.IsNullOrEmpty(Model.Email) ? "غير محدد" : Model.Email)</span>
                                                </p>
                                                @if (!string.IsNullOrEmpty(Model.Website))
                                                {
                                                    <p class="mb-2">
                                                        <i class="fas fa-globe text-primary me-2"></i>
                                                        <strong>الموقع الإلكتروني:</strong> 
                                                        <span class="text-muted">@Model.Website</span>
                                                    </p>
                                                }
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-12 mb-3">
                                                <p class="mb-2">
                                                    <i class="fas fa-map-marker-alt text-danger me-2"></i>
                                                    <strong>العنوان:</strong> 
                                                    <span class="text-muted">@(string.IsNullOrEmpty(Model.Address) ? "غير محدد" : Model.Address)</span>
                                                </p>
                                            </div>
                                        </div>

                                        @if (!string.IsNullOrEmpty(Model.TaxNumber) || !string.IsNullOrEmpty(Model.CommercialRegister))
                                        {
                                            <hr />
                                            <div class="row">
                                                @if (!string.IsNullOrEmpty(Model.TaxNumber))
                                                {
                                                    <div class="col-md-6 mb-2">
                                                        <p class="mb-0">
                                                            <i class="fas fa-file-invoice text-warning me-2"></i>
                                                            <strong>الرقم الضريبي:</strong> 
                                                            <span class="text-muted">@Model.TaxNumber</span>
                                                        </p>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrEmpty(Model.CommercialRegister))
                                                {
                                                    <div class="col-md-6 mb-2">
                                                        <p class="mb-0">
                                                            <i class="fas fa-certificate text-secondary me-2"></i>
                                                            <strong>السجل التجاري:</strong> 
                                                            <span class="text-muted">@Model.CommercialRegister</span>
                                                        </p>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="alert alert-info">
                            <i class="fas fa-info-circle me-2"></i>
                            <strong>ملاحظة:</strong> هذه المعلومات ستظهر في الفواتير المطبوعة لطلبات البيع وأوامر الشراء.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
