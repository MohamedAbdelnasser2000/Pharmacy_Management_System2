@model IMS.Models.Supplier
@{
    ViewData["Title"] = "حذف مورد الأدوية - الصيدلية";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0"><i class="fas fa-trash-alt text-danger"></i> حذف مورد الأدوية</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">الرئيسية</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">الموردون</a></li>
                    <li class="breadcrumb-item active">حذف</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-gradient-danger text-white">
                <h5 class="card-title mb-0"><i class="fas fa-exclamation-triangle"></i> تأكيد حذف مورد الأدوية</h5>
            </div>
            <div class="card-body">
                <div class="alert alert-danger">
                    <i class="fas fa-exclamation-circle"></i>
                    <strong>تحذير:</strong> هل أنت متأكد من حذف مورد الأدوية التالي؟
                </div>
                <dl class="row">
                    <dt class="col-sm-3"><i class="fas fa-building"></i> الاسم:</dt>
                    <dd class="col-sm-9"><strong>@Model.Name</strong></dd>
                    
                    <dt class="col-sm-3"><i class="fas fa-phone"></i> الهاتف:</dt>
                    <dd class="col-sm-9">@Model.PhoneNumber</dd>
                    
                    <dt class="col-sm-3"><i class="fas fa-envelope"></i> البريد:</dt>
                    <dd class="col-sm-9">@Model.Email</dd>
                </dl>
            </div>
            <div class="card-footer text-end">
                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
                    <button type="submit" class="btn btn-danger">حذف</button>
                </form>
            </div>
        </div>
    </div>
</section>