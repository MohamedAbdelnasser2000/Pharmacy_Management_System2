@model IEnumerable<IMS.Models.Branch>

@{
    ViewData["Title"] = "إدارة الفروع - الصيدلية";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0"><i class="fas fa-network-wired text-primary"></i> إدارة الفروع</h1>
            </div>
            <div class="col-sm-6 text-end">
                <a asp-action="Create" class="btn btn-primary rounded-pill px-4">
                    <i class="fas fa-plus-circle me-1"></i> إضافة فرع جديد
                </a>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>اسم الفرع</th>
                                <th>الكود</th>
                                <th>الموقع</th>
                                <th>عدد المستودعات</th>
                                <th class="text-center">الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Id</td>
                                    <td><strong>@item.Name</strong></td>
                                    <td><span class="badge bg-secondary">@item.Code</span></td>
                                    <td>@item.Location</td>
                                    <td>
                                        <span class="badge bg-info">@item.Warehouses.Count</span>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="تعديل">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="حذف">
                                                <i class="fas fa-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>
