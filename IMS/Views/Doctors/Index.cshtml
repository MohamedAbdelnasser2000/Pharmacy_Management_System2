@model IEnumerable<IMS.Models.Doctor>

@{
    ViewData["Title"] = "إدارة الأطباء";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0"><i class="fas fa-user-md text-info"></i> إدارة الأطباء</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-start">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">الرئيسية</a></li>
                    <li class="breadcrumb-item active">الأطباء</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-header">
                <div class="row">
                    <div class="col-md-8">
                        <form asp-action="Index" method="get" class="form-inline">
                            <div class="input-group">
                                <input type="text" name="searchString" value="@ViewData["SearchString"]" class="form-control" placeholder="البحث بالاسم، التخصص، أو رقم الترخيص..." />
                                <select name="isActive" class="form-control ms-2">
                                    <option value="">الكل</option>
                                    <option value="true" selected="@(ViewData["IsActive"]?.ToString() == "True")">نشط</option>
                                    <option value="false" selected="@(ViewData["IsActive"]?.ToString() == "False")">غير نشط</option>
                                </select>
                                <button type="submit" class="btn btn-primary ms-2">
                                    <i class="fas fa-search"></i> بحث
                                </button>
                                <a asp-action="Index" class="btn btn-secondary ms-2">
                                    <i class="fas fa-redo"></i> إعادة تعيين
                                </a>
                            </div>
                        </form>
                    </div>
                    <div class="col-md-4 text-start">
                        <a asp-action="Create" class="btn btn-success">
                            <i class="fas fa-plus"></i> إضافة طبيب جديد
                        </a>
                    </div>
                </div>
            </div>
            <div class="card-body">
                @if (Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped table-hover">
                            <thead class="table-primary">
                                <tr>
                                    <th>الاسم</th>
                                    <th>التخصص</th>
                                    <th>رقم الترخيص</th>
                                    <th>رقم الهاتف</th>
                                    <th>المستشفى/العيادة</th>
                                    <th>الحالة</th>
                                    <th>تاريخ الإضافة</th>
                                    <th style="width: 180px;">الإجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var doctor in Model)
                                {
                                    <tr>
                                        <td>
                                            <i class="fas fa-user-md text-info"></i>
                                            <strong>@doctor.Name</strong>
                                        </td>
                                        <td>@doctor.Specialization</td>
                                        <td><span class="badge bg-secondary">@doctor.LicenseNumber</span></td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(doctor.Phone))
                                            {
                                                <i class="fas fa-phone"></i> @doctor.Phone
                                            }
                                        </td>
                                        <td>@doctor.Hospital</td>
                                        <td>
                                            @if (doctor.IsActive)
                                            {
                                                <span class="badge bg-success">نشط</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">غير نشط</span>
                                            }
                                        </td>
                                        <td>@doctor.CreatedDate.ToString("yyyy-MM-dd")</td>
                                        <td>
                                            <div class="btn-group" role="group">
                                                <a asp-action="Details" asp-route-id="@doctor.Id" class="btn btn-sm btn-info" title="التفاصيل">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <a asp-action="Edit" asp-route-id="@doctor.Id" class="btn btn-sm btn-warning" title="تعديل">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@doctor.Id" class="btn btn-sm btn-danger" title="حذف">
                                                    <i class="fas fa-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info text-center">
                        <i class="fas fa-info-circle fa-2x mb-2"></i>
                        <p class="mb-0">لا توجد بيانات أطباء حالياً. يمكنك إضافة طبيب جديد من الزر أعلاه.</p>
                    </div>
                }
            </div>
            @if (Model.Any())
            {
                <div class="card-footer">
                    <div class="text-muted">
                        <i class="fas fa-info-circle"></i>
                        إجمالي الأطباء: <strong>@Model.Count()</strong>
                        | نشط: <strong>@Model.Count(d => d.IsActive)</strong>
                        | غير نشط: <strong>@Model.Count(d => !d.IsActive)</strong>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
