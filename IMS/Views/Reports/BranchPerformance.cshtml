@model IEnumerable<IMS.Controllers.BranchPerformanceViewModel>
@{
    ViewData["Title"] = "تقرير أداء الفروع - الصيدلية";
    var start = (DateTime)ViewBag.StartDate;
    var end = (DateTime)ViewBag.EndDate;
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0"><i class="fas fa-chart-line text-success"></i> أداء الفروع المقارن</h1>
            </div>
            <div class="col-sm-6">
                <form asp-action="BranchPerformance" method="get" class="row gx-2 gy-2 align-items-end float-sm-end">
                    <div class="col-auto">
                        <label class="small text-muted">من:</label>
                        <input type="date" name="startDate" value="@start.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
                    </div>
                    <div class="col-auto">
                        <label class="small text-muted">إلى:</label>
                        <input type="date" name="endDate" value="@end.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-sm btn-primary mt-4"><i class="fas fa-filter"></i> تحديث</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <!-- Summary Cards -->
        <div class="row">
            <div class="col-md-4">
                <div class="info-box bg-gradient-info">
                    <span class="info-box-icon"><i class="fas fa-shopping-cart"></i></span>
                    <div class="info-box-content">
                        <span class="info-box-text">إجمالي مبيعات الشبكة</span>
                        <span class="info-box-number fs-4">@Model.Sum(x => x.TotalSales).ToString("N2") جنيه</span>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="info-box bg-gradient-success">
                    <span class="info-box-icon"><i class="fas fa-receipt"></i></span>
                    <div class="info-box-content">
                        <span class="info-box-text">إجمالي عدد الطلبات</span>
                        <span class="info-box-number fs-4">@Model.Sum(x => x.OrderCount) طلب</span>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="info-box bg-gradient-warning">
                    <span class="info-box-icon"><i class="fas fa-users"></i></span>
                    <div class="info-box-content">
                        <span class="info-box-text">متوسط قيمة السلة</span>
                        <span class="info-box-number fs-4">
                            @((Model.Sum(x => x.OrderCount) > 0 ? Model.Sum(x => x.TotalSales) / Model.Sum(x => x.OrderCount) : 0).ToString("N2")) جنيه
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-header bg-navy text-white">
                <h5 class="card-title mb-0"><i class="fas fa-table"></i> تحليل أداء الفروع المكتملة</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>اسم الفرع</th>
                                <th class="text-center">إجمالي المبيعات</th>
                                <th class="text-center">عدد الطلبات</th>
                                <th class="text-center">عدد العملاء الفريدين</th>
                                <th class="text-center">متوسط الفاتورة</th>
                                <th class="text-center">الحصة السوقية</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var grandTotal = Model.Sum(x => x.TotalSales);
                            }
                            @foreach (var item in Model)
                            {
                                var share = grandTotal > 0 ? (item.TotalSales / grandTotal) * 100 : 0;
                                <tr>
                                    <td class="fw-bold">@item.BranchName</td>
                                    <td class="text-center text-primary fw-bold">@item.TotalSales.ToString("N2") جنيه</td>
                                    <td class="text-center">@item.OrderCount</td>
                                    <td class="text-center"><span class="badge bg-secondary">@item.CustomerCount</span></td>
                                    <td class="text-center">@item.AverageOrderValue.ToString("N2") جنيه</td>
                                    <td class="text-center">
                                        <div class="progress progress-xs" style="height: 10px;">
                                            <div class="progress-bar bg-success" style="width: @share.ToString("N0")%"></div>
                                        </div>
                                        <small>@share.ToString("N1")%</small>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>
