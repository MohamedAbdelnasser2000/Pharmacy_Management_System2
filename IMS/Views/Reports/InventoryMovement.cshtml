@model IEnumerable<IMS.Models.StockMovement>

@{
    ViewData["Title"] = "تقرير حركة المخزون - الصيدلية";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0"><i class="fas fa-exchange-alt text-warning"></i> تقرير حركة المخزون</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a asp-controller="Reports" asp-action="Index">التقارير</a></li>
                    <li class="breadcrumb-item active">حركة المخزون</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body">
                <form method="get" class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label font-weight-bold">المنتج</label>
                        <select name="productId" class="form-select select2" asp-items="ViewBag.Products">
                            <option value="">-- كل المنتجات --</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label font-weight-bold">من تاريخ</label>
                        <input type="date" name="startDate" class="form-control" value="@(((DateTime)ViewBag.StartDate).ToString("yyyy-MM-dd"))">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label font-weight-bold">إلى تاريخ</label>
                        <input type="date" name="endDate" class="form-control" value="@(((DateTime)ViewBag.EndDate).ToString("yyyy-MM-dd"))">
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-warning w-100 text-dark fw-bold">
                            <i class="fas fa-filter me-1"></i> تصفية
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>التاريخ</th>
                                <th>المنتج</th>
                                <th>المستودع</th>
                                <th>نوع الحركة</th>
                                <th>الكمية</th>
                                <th>السبب</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var move in Model)
                            {
                                <tr>
                                    <td class="text-nowrap text-muted">@move.MovementDate.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td class="fw-bold">@move.Product?.Name</td>
                                    <td>@move.Warehouse?.Name</td>
                                    <td>
                                        @{
                                            var badgeClass = move.MovementType == "إدخال" || move.MovementType == "شراء" ? "bg-success" : "bg-danger";
                                        }
                                        <span class="badge @badgeClass">@move.MovementType</span>
                                    </td>
                                    <td class="fw-bold fs-6">@move.Quantity.ToString("N0")</td>
                                    <td class="text-muted small">@move.Reason</td>
                                </tr>
                            }
                            @if (!Model.Any())
                            {
                                <tr><td colspan="6" class="text-center py-5 text-muted">لا توجد حركات مخزون مسجلة للفترة المحددة</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>
