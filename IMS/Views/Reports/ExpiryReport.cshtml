@model IEnumerable<IMS.Models.ExpiryAlert>

@{
    ViewData["Title"] = "تقرير أدوية منتهية الصلاحية وقريبة الانتهاء - الصيدلية";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0"><i class="fas fa-hourglass-end text-danger"></i> تقرير تواريخ الصلاحية</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a asp-controller="Reports" asp-action="Index">التقارير</a></li>
                    <li class="breadcrumb-item active">تواريخ الصلاحية</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-danger text-white">
                        <h5 class="card-title mb-0"><i class="fas fa-exclamation-circle me-1"></i> الأدوية المنتهية أو قريبة الانتهاء</h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>المنتج</th>
                                        <th>تاريخ الصلاحية</th>
                                        <th>الحالة</th>
                                        <th>الأيام المتبقية</th>
                                        <th>تاريخ التنبيه</th>
                                        <th class="text-center">الإجراء</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var alert in Model)
                                    {
                                        var daysRemaining = (alert.ExpiryDate - AppClock.UtcNow).Days;
                                        <tr>
                                            <td class="fw-bold">@alert.Product?.Name</td>
                                            <td class="text-danger fw-bold">@alert.ExpiryDate.ToString("yyyy-MM-dd")</td>
                                            <td>
                                                @if (daysRemaining <= 0)
                                                {
                                                    <span class="badge bg-danger">منتهي الصلاحية</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark">قريب الانتهاء</span>
                                                }
                                            </td>
                                            <td class="fw-bold">
                                                @if (daysRemaining <= 0)
                                                {
                                                    <span class="text-danger">منتهي منذ @Math.Abs(daysRemaining) يوم</span>
                                                }
                                                else
                                                {
                                                    <span>@daysRemaining يوم متبقي</span>
                                                }
                                            </td>
                                            <td class="text-muted small">@alert.AlertDate.ToString("yyyy-MM-dd")</td>
                                            <td class="text-center">
                                                <a asp-controller="Products" asp-action="Details" asp-route-id="@alert.ProductId" class="btn btn-sm btn-outline-primary rounded-pill">معاينة</a>
                                            </td>
                                        </tr>
                                    }
                                    @if (!Model.Any())
                                    {
                                        <tr><td colspan="6" class="text-center py-5 text-muted">لا توجد تنبيهات صلاحية حالياً (بناءً على إعدادات النظام)</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="card-footer bg-white border-top-0 py-3">
                        <p class="mb-0 text-muted small"><i class="fas fa-info-circle me-1"></i> يتم إنشاء هذه التنبيهات تلقائياً عبر خدمة الخلفية للأدوية التي تنتهي خلال 90 يوماً.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
