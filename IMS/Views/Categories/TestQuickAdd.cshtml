@{
    ViewData["Title"] = "اختبار إضافة فئة سريعة";
}

<div class="container mt-5">
    <h2>اختبار إضافة فئة جديدة</h2>
    
    <div class="card mt-4">
        <div class="card-body">
            <form id="testCategoryForm">
                @Html.AntiForgeryToken()
                
                <div class="mb-3">
                    <label for="testName" class="form-label">اسم الفئة</label>
                    <input type="text" class="form-control" id="testName" name="Name" required>
                </div>
                
                <div class="mb-3">
                    <label for="testDescription" class="form-label">الوصف</label>
                    <textarea class="form-control" id="testDescription" name="Description" rows="3"></textarea>
                </div>
                
                <div class="mb-3 form-check">
                    <input type="checkbox" class="form-check-input" id="testIsActive" name="IsActive" checked>
                    <label class="form-check-label" for="testIsActive">نشط</label>
                </div>
                
                <button type="submit" class="btn btn-primary">حفظ</button>
            </form>
            
            <div id="result" class="mt-3"></div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    if (typeof $ === 'undefined') {
        document.getElementById('result').innerHTML = '<div class="alert alert-danger">jQuery غير محمل!</div>';
        return;
    }
    
    $('#testCategoryForm').on('submit', function(e) {
        e.preventDefault();
        
        var formData = {
            Name: $('#testName').val(),
            Description: $('#testDescription').val(),
            IsActive: $('#testIsActive').is(':checked')
        };
        
        var token = $('input[name="__RequestVerificationToken"]', this).val();
        if (token) {
            formData.__RequestVerificationToken = token;
        }
        
        console.log('Sending data:', formData);
        $('#result').html('<div class="alert alert-info">جاري الإرسال...</div>');
        
        $.ajax({
            url: '@Url.Action("CreateQuick", "Categories")',
            type: 'POST',
            data: formData,
            success: function(response) {
                console.log('Response:', response);
                if (response.success) {
                    $('#result').html('<div class="alert alert-success">تم الحفظ بنجاح! ID: ' + response.category.id + ', Name: ' + response.category.name + '</div>');
                    $('#testCategoryForm')[0].reset();
                    $('#testIsActive').prop('checked', true);
                } else {
                    var errorMsg = 'فشل الحفظ: ';
                    if (response.errors) {
                        errorMsg += JSON.stringify(response.errors);
                    } else if (response.message) {
                        errorMsg += response.message;
                    }
                    $('#result').html('<div class="alert alert-danger">' + errorMsg + '</div>');
                }
            },
            error: function(xhr, status, error) {
                console.error('Error:', xhr.responseText);
                $('#result').html('<div class="alert alert-danger">خطأ: ' + xhr.status + ' - ' + error + '<br>Response: ' + xhr.responseText + '</div>');
            }
        });
    });
});
</script>
