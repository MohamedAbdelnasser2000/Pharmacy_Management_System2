@model IEnumerable<IMS.Models.ProductInventory>
@{
    ViewData["Title"] = "تقرير المخزون الدوائي - الصيدلية";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">
                    <i class="fas fa-pills text-primary"></i>
                    تقرير المخزون الدوائي الشامل
                </h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">الرئيسية</a></li>
                    <li class="breadcrumb-item"><a asp-action="Movements">المخزون</a></li>
                    <li class="breadcrumb-item active">التقرير</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="row mb-3">
            <div class="col-md-12">
                <div class="btn-group">
                    <button class="btn btn-success" onclick="window.print()">
                        <i class="fas fa-print"></i> طباعة
                    </button>
                    <button class="btn btn-primary" onclick="exportToExcel()">
                        <i class="fas fa-file-excel"></i> تصدير Excel
                    </button>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-header bg-gradient-primary text-white">
                <h5 class="card-title mb-0"><i class="fas fa-warehouse"></i> مخزون الأدوية حسب المخازن</h5>
            </div>
            <div class="card-body">
                @if (!Model.Any())
                {
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i>
                        لا توجد بيانات مخزون دوائي حالياً. ابدأ بإضافة أدوية وتوزيعها على المخازن.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover" id="inventoryTable">
                            <thead class="table-dark">
                                <tr>
                                    <th>الدواء</th>
                                    <th>الكود</th>
                                    <th>المخزن</th>
                                    <th>الكمية المتاحة</th>
                                    <th>الكمية المحجوزة</th>
                                    <th>الكمية الفعلية</th>
                                    <th>الحالة</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.OrderBy(i => i.Product.Name))
                                {
                                    var isLow = item.Product.LowStockThreshold.HasValue && item.Product.LowStockThreshold.Value > 0 && item.AvailableQuantity <= item.Product.LowStockThreshold.Value;
                                    <tr class="@(isLow ? "table-warning" : "")">
                                        <td>
                                            <a asp-controller="Products" asp-action="Details" asp-route-id="@item.ProductId">
                                                @item.Product?.Name
                                            </a>
                                        </td>
                                        <td>@item.Product?.Code</td>
                                        <td>@item.Warehouse?.Name</td>
                                        <td class="fw-bold">@item.OnHandQuantity</td>
                                        <td>@item.ReservedQuantity</td>
                                        <td class="fw-bold text-primary">@item.AvailableQuantity</td>
                                        <td>
                                            @if (isLow)
                                            {
                                                <span class="badge bg-warning">
                                                    <i class="fas fa-exclamation-triangle"></i> منخفض
                                                </span>
                                            }
                                            else if (item.AvailableQuantity == 0)
                                            {
                                                <span class="badge bg-danger">
                                                    <i class="fas fa-times"></i> نفذ
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">
                                                    <i class="fas fa-check"></i> متوفر
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="table-info fw-bold">
                                    <td colspan="3">الإجمالي</td>
                                    <td>@Model.Sum(i => i.OnHandQuantity)</td>
                                    <td>@Model.Sum(i => i.ReservedQuantity)</td>
                                    <td>@Model.Sum(i => i.AvailableQuantity)</td>
                                    <td>-</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
            </div>
        </div>

        @if (Model.Any())
        {
            <div class="row mt-3">
                <div class="col-md-4">
                    <div class="card bg-gradient-success text-white shadow-sm">
                        <div class="card-body">
                            <h5>إجمالي الكمية المتاحة</h5>
                            <h2>@Model.Sum(i => i.OnHandQuantity)</h2>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card bg-gradient-warning text-white shadow-sm">
                        <div class="card-body">
                            <h5>الكمية المحجوزة</h5>
                            <h2>@Model.Sum(i => i.ReservedQuantity)</h2>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card bg-gradient-primary text-white shadow-sm">
                        <div class="card-body">
                            <h5>الكمية الفعلية</h5>
                            <h2>@Model.Sum(i => i.AvailableQuantity)</h2>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@section Scripts {
    <script>
        function exportToExcel() {
            var table = document.getElementById('inventoryTable');
            var html = table.outerHTML;
            var url = 'data:application/vnd.ms-excel,' + encodeURIComponent(html);
            var link = document.createElement('a');
            link.href = url;
            link.download = 'تقرير_المخزون_' + new Date().toISOString().split('T')[0] + '.xls';
            link.click();
        }
    </script>
}
