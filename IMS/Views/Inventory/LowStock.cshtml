@model IEnumerable<IMS.Models.Product>
@{
    ViewData["Title"] = "تنبيهات المخزون المنخفض";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 text-dark">
                    <i class="fas fa-exclamation-triangle text-warning"></i>
                    تنبيهات المخزون المنخفض
                </h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">الرئيسية</a></li>
                    <li class="breadcrumb-item"><a asp-action="Movements">المخزون</a></li>
                    <li class="breadcrumb-item active">تنبيهات</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        @if (!Model.Any())
        {
            <div class="alert alert-success">
                <i class="fas fa-check-circle"></i>
                <strong>رائع!</strong> جميع المنتجات فوق الحد الأدنى للمخزون.
            </div>
        }
        else
        {
            <div class="alert alert-warning">
                <i class="fas fa-exclamation-triangle"></i>
                <strong>تنبيه:</strong> يوجد @Model.Count() منتج تحت الحد الأدنى للمخزون. يرجى إعادة الطلب.
            </div>

            <div class="card">
                <div class="card-header bg-warning">
                    <h5 class="card-title mb-0">المنتجات التي تحتاج إعادة طلب</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>الكود</th>
                                    <th>اسم المنتج</th>
                                    <th>الكمية الحالية</th>
                                    <th>الحد الأدنى</th>
                                    <th>المورد</th>
                                    <th>الإجراء</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.Code</td>
                                        <td class="fw-bold">@item.Name</td>
                                        <td>
                                            <span class="badge bg-danger">@item.TotalQuantity</span>
                                        </td>
                                        <td>@item.LowStockThreshold</td>
                                        <td>@item.Supplier?.Name</td>
                                        <td>
                                            <a asp-controller="Products" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-eye"></i> عرض
                                            </a>
                                            @if (item.Supplier != null)
                                            {
                                                <a asp-controller="PurchaseOrders" asp-action="Create" class="btn btn-sm btn-outline-success">
                                                    <i class="fas fa-shopping-cart"></i> طلب
                                                </a>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
</section>
