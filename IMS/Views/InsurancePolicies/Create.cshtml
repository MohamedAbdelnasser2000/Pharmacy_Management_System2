@model IMS.Models.InsurancePolicy

@{
    ViewData["Title"] = "إضافة بوليصة تأمين";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0"><i class="fas fa-file-contract text-success"></i> إضافة بوليصة تأمين جديدة</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-start">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">الرئيسية</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">بوليصات التأمين</a></li>
                    <li class="breadcrumb-item active">إضافة جديد</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-10 offset-md-1">
                <div class="card card-success">
                    <div class="card-header">
                        <h3 class="card-title"><i class="fas fa-plus"></i> معلومات البوليصة</h3>
                    </div>
                    <form asp-action="Create" method="post">
                        <div class="card-body">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                            
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="PolicyNumber" class="control-label">
                                            <i class="fas fa-hashtag"></i> رقم البوليصة <span class="text-danger">*</span>
                                        </label>
                                        <input asp-for="PolicyNumber" class="form-control" placeholder="مثال: POL-2025-001" />
                                        <span asp-validation-for="PolicyNumber" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="InsuranceId" class="control-label">
                                            <i class="fas fa-shield-alt"></i> شركة التأمين <span class="text-danger">*</span>
                                        </label>
                                        <select asp-for="InsuranceId" class="form-control" asp-items="ViewBag.InsuranceId">
                                            <option value="">-- اختر شركة التأمين --</option>
                                        </select>
                                        <span asp-validation-for="InsuranceId" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="CustomerId" class="control-label">
                                            <i class="fas fa-user"></i> العميل
                                        </label>
                                        <select asp-for="CustomerId" class="form-control" asp-items="ViewBag.CustomerId">
                                            <option value="">-- اختر العميل --</option>
                                        </select>
                                        <span asp-validation-for="CustomerId" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="PolicyHolderName" class="control-label">
                                            <i class="fas fa-user-tag"></i> اسم صاحب البوليصة
                                        </label>
                                        <input asp-for="PolicyHolderName" class="form-control" placeholder="اسم صاحب البوليصة" />
                                        <span asp-validation-for="PolicyHolderName" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="StartDate" class="control-label">
                                            <i class="fas fa-calendar-check"></i> تاريخ البداية <span class="text-danger">*</span>
                                        </label>
                                        <input asp-for="StartDate" class="form-control" type="date" />
                                        <span asp-validation-for="StartDate" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="EndDate" class="control-label">
                                            <i class="fas fa-calendar-times"></i> تاريخ الانتهاء <span class="text-danger">*</span>
                                        </label>
                                        <input asp-for="EndDate" class="form-control" type="date" />
                                        <span asp-validation-for="EndDate" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="CoveragePercentage" class="control-label">
                                            <i class="fas fa-percentage"></i> نسبة التغطية (%) <span class="text-danger">*</span>
                                        </label>
                                        <input asp-for="CoveragePercentage" class="form-control" type="number" step="0.01" min="0" max="100" placeholder="مثال: 80" />
                                        <span asp-validation-for="CoveragePercentage" class="text-danger"></span>
                                        <small class="form-text text-muted">النسبة المئوية للتغطية (0-100)</small>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="MaxCoverageAmount" class="control-label">
                                            <i class="fas fa-money-bill"></i> الحد الأقصى للتغطية (ج.م) <span class="text-danger">*</span>
                                        </label>
                                        <input asp-for="MaxCoverageAmount" class="form-control" type="number" step="0.01" min="0" placeholder="مثال: 50000" />
                                        <span asp-validation-for="MaxCoverageAmount" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                <label asp-for="Notes" class="control-label">
                                    <i class="fas fa-sticky-note"></i> ملاحظات
                                </label>
                                <textarea asp-for="Notes" class="form-control" rows="3" placeholder="أي ملاحظات إضافية"></textarea>
                                <span asp-validation-for="Notes" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <div class="custom-control custom-switch">
                                    <input asp-for="IsActive" class="custom-control-input" type="checkbox" id="isActiveSwitch" checked />
                                    <label class="custom-control-label" for="isActiveSwitch">
                                        <i class="fas fa-toggle-on"></i> نشط
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer">
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save"></i> حفظ
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-right"></i> رجوع
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
