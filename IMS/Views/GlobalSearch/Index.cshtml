@model IMS.Controllers.SearchViewModel
@{
    ViewData["Title"] = "نتائج البحث الشامل";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0"><i class="fas fa-search text-primary"></i> نتائج البحث عن: "@Model.Query"</h1>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        @if (!Model.Products.Any() && !Model.Orders.Any() && !Model.Customers.Any() && !Model.Prescriptions.Any())
        {
            <div class="alert alert-info shadow-sm">
                <h5><i class="icon fas fa-info"></i> عذراً!</h5>
                لا توجد نتائج تطابق بحثك. جرب كلمات مفتاحية أخرى.
            </div>
        }
        else
        {
            <div class="row">
                @if (Model.Products.Any())
                {
                    <div class="col-md-6">
                        <div class="card card-primary card-outline shadow-sm">
                            <div class="card-header">
                                <h3 class="card-title fw-bold"><i class="fas fa-pills me-2"></i> الأدوية والمنتجات</h3>
                            </div>
                            <div class="card-body p-0">
                                <div class="list-group list-group-flush">
                                    @foreach (var p in Model.Products)
                                    {
                                        <a asp-controller="Products" asp-action="Details" asp-route-id="@p.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                            <div>
                                                <div class="fw-bold">@p.Name</div>
                                                <small class="text-muted">كود: @p.Code @(string.IsNullOrEmpty(p.ScientificName) ? "" : $"| {p.ScientificName}")</small>
                                            </div>
                                            <span class="badge bg-primary rounded-pill">@p.SalePrice?.ToString("C")</span>
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }

                @if (Model.Customers.Any())
                {
                    <div class="col-md-6">
                        <div class="card card-success card-outline shadow-sm">
                            <div class="card-header">
                                <h3 class="card-title fw-bold"><i class="fas fa-user-injured me-2"></i> العملاء والمرضى</h3>
                            </div>
                            <div class="card-body p-0">
                                <div class="list-group list-group-flush">
                                    @foreach (var c in Model.Customers)
                                    {
                                        <a asp-controller="Customers" asp-action="Details" asp-route-id="@c.Id" class="list-group-item list-group-item-action">
                                            <div class="fw-bold">@c.Name</div>
                                            <small class="text-muted"><i class="fas fa-phone-alt me-1 text-xs"></i> @c.PhoneNumber</small>
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }

                @if (Model.Orders.Any())
                {
                    <div class="col-md-12 mt-3">
                        <div class="card card-info card-outline shadow-sm">
                            <div class="card-header">
                                <h3 class="card-title fw-bold"><i class="fas fa-file-invoice-dollar me-2"></i> فواتير المبيعات</h3>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-hover mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>رقم الفاتورة</th>
                                                <th>العميل</th>
                                                <th>التاريخ</th>
                                                <th>المبلغ</th>
                                                <th>الحالة</th>
                                                <th>إجراء</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var o in Model.Orders)
                                            {
                                                <tr>
                                                    <td>#@o.Id</td>
                                                    <td>@o.Customer?.Name</td>
                                                    <td>@o.OrderDate.ToString("yyyy/MM/dd")</td>
                                                    <td class="fw-bold">@o.TotalAmount.ToString("C")</td>
                                                    <td>
                                                        <span class="badge @(o.Status == "مكتمل" ? "bg-success" : "bg-warning")">@o.Status</span>
                                                    </td>
                                                    <td>
                                                        <a asp-controller="Orders" asp-action="Details" asp-route-id="@o.Id" class="btn btn-sm btn-info text-white">
                                                            <i class="fas fa-eye"></i>
                                                        </a>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                @if (Model.Prescriptions.Any())
                {
                    <div class="col-md-12 mt-3">
                        <div class="card card-warning card-outline shadow-sm">
                            <div class="card-header">
                                <h3 class="card-title fw-bold"><i class="fas fa-prescription me-2"></i> الوصفات الطبية</h3>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-hover mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>رقم الوصفة</th>
                                                <th>المريض</th>
                                                <th>الطبيب</th>
                                                <th>التاريخ</th>
                                                <th>الحالة</th>
                                                <th>إجراء</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var p in Model.Prescriptions)
                                            {
                                                <tr>
                                                    <td>@p.PrescriptionNumber</td>
                                                    <td>@p.PatientName</td>
                                                    <td>@(p.Doctor?.Name ?? "---")</td>
                                                    <td>@p.CreatedDate.ToString("yyyy/MM/dd")</td>
                                                    <td>
                                                        <span class="badge @(p.IsDispensed ? "bg-success" : "bg-primary")">
                                                            @(p.IsDispensed ? "تم الصرف" : "جديدة")
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <a asp-controller="Prescriptions" asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-warning">
                                                            <i class="fas fa-eye"></i>
                                                        </a>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>
