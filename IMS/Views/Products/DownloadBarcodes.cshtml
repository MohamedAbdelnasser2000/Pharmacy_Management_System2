@model IMS.Models.Product

@{
    ViewData["Title"] = "تحميل الباركودات";
    var quantity = ViewBag.Quantity ?? 1;
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-check-circle-fill"></i>
                        تم إضافة المنتج بنجاح
                    </h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-info">
                        <h5 class="alert-heading">
                            <i class="bi bi-info-circle"></i>
                            معلومات المنتج
                        </h5>
                        <hr>
                        <div class="row">
                            <div class="col-md-6">
                                <p><strong>اسم المنتج:</strong> @Model.Name</p>
                                <p><strong>الباركود:</strong> <code>@Model.Barcode</code></p>
                            </div>
                            <div class="col-md-6">
                                <p><strong>الكمية:</strong> @quantity</p>
                                @if (Model.SalePrice.HasValue)
                                {
                                    <p><strong>سعر البيع:</strong> @Model.SalePrice.Value.ToString("N2") جنيه</p>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="text-center my-4">
                        <div class="mb-3">
                            <img src="@Url.Action("GenerateBarcodeImage", new { id = Model.Id })" 
                                 alt="Barcode" 
                                 class="img-fluid border rounded p-2"
                                 style="max-width: 400px;">
                        </div>
                        <p class="text-muted">
                            <i class="bi bi-upc-scan"></i>
                            الباركود: @Model.Barcode
                        </p>
                    </div>

                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle"></i>
                        <strong>ملاحظة:</strong> سيتم توليد <strong>@quantity</strong> باركود في ملف PDF للطباعة ولصقها على المنتجات.
                    </div>

                    <div class="d-grid gap-3">
                        <a href="@Url.Action("GenerateBarcodePDF", new { id = Model.Id, quantity = quantity })" 
                           class="btn btn-primary btn-lg">
                            <i class="bi bi-file-earmark-pdf"></i>
                            تحميل ملف PDF للطباعة (@quantity باركود)
                        </a>
                        
                        <div class="row g-2">
                            <div class="col-md-6">
                                <a href="@Url.Action("Details", new { id = Model.Id })" 
                                   class="btn btn-outline-info w-100">
                                    <i class="bi bi-eye"></i>
                                    عرض تفاصيل المنتج
                                </a>
                            </div>
                            <div class="col-md-6">
                                <a href="@Url.Action("Index")" 
                                   class="btn btn-outline-secondary w-100">
                                    <i class="bi bi-list"></i>
                                    العودة إلى قائمة المنتجات
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mt-3 shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="bi bi-printer"></i>
                        إرشادات الطباعة
                    </h5>
                </div>
                <div class="card-body">
                    <ol class="mb-0">
                        <li>اضغط على زر "تحميل ملف PDF للطباعة" أعلاه</li>
                        <li>افتح الملف المحمل باستخدام قارئ PDF</li>
                        <li>اطبع الملف على ورق لاصق أو ورق عادي</li>
                        <li>قص الباركودات والصقها على المنتجات</li>
                        <li>تأكد من وضوح الباركود للمسح الضوئي</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // تحميل تلقائي لملف PDF بعد 2 ثانية (اختياري)
        // setTimeout(function() {
        //     window.location.href = '@Url.Action("GenerateBarcodePDF", new { id = Model.Id, quantity = quantity })';
        // }, 2000);
    </script>
}
