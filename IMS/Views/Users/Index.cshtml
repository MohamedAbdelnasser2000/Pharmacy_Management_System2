@model IEnumerable<IMS.ViewModels.UserViewModel>

@{
    ViewData["Title"] = "إدارة المستخدمين - الصيدلية";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0"><i class="fas fa-users-cog text-primary"></i> إدارة المستخدمين</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">الرئيسية</a></li>
                    <li class="breadcrumb-item active">المستخدمين</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0"><i class="fas fa-list"></i> قائمة المستخدمين</h5>
                    <a asp-action="Create" class="btn btn-primary btn-sm rounded-pill">
                        <i class="fas fa-user-plus"></i> إضافة مستخدم جديد
                    </a>
                </div>
            </div>
            <div class="card-body">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fas fa-check-circle me-1"></i> @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>الاسم الكامل</th>
                                <th>البريد الإلكتروني</th>
                                <th>الفرع</th>
                                <th>الأدوار</th>
                                <th>الحالة</th>
                                <th class="text-center">الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-sm bg-light rounded-circle p-2 me-2">
                                                <i class="fas fa-user text-muted"></i>
                                            </div>
                                            <div>
                                                <span class="fw-bold">@item.FullName</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@item.Email</td>
                                    <td>
                                        <span class="badge bg-secondary-soft text-secondary border">
                                            <i class="fas fa-building me-1"></i> @(item.BranchName ?? "غير محدد")
                                        </span>
                                    </td>
                                    <td>
                                        @foreach (var role in item.Roles)
                                        {
                                            <span class="badge bg-info-soft text-info border me-1">@role</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success-soft text-success border">
                                                <i class="fas fa-circle translate-middle-y me-1 font-size-8"></i> نشط
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-soft text-danger border">
                                                <i class="fas fa-circle translate-middle-y me-1 font-size-8"></i> معطل
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm" title="تعديل">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a asp-action="ChangePassword" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm" title="تغيير كلمة المرور">
                                                <i class="fas fa-key"></i>
                                            </a>
                                            <form asp-action="ToggleStatus" asp-route-id="@item.Id" method="post" class="d-inline ms-1">
                                                @if (item.IsActive)
                                                {
                                                    <button type="submit" class="btn btn-outline-danger btn-sm" title="تعطيل" onclick="return confirm('هل أنت متأكد من تعطيل هذا المستخدم؟')">
                                                        <i class="fas fa-user-slash"></i>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit" class="btn btn-outline-success btn-sm" title="تفعيل">
                                                        <i class="fas fa-user-check"></i>
                                                    </button>
                                                }
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .bg-info-soft { background-color: rgba(13, 202, 240, 0.1); }
    .text-info { color: #0dcaf0 !important; }
    .bg-success-soft { background-color: rgba(25, 135, 84, 0.1); }
    .text-success { color: #198754 !important; }
    .bg-danger-soft { background-color: rgba(220, 53, 69, 0.1); }
    .text-danger { color: #dc3545 !important; }
    .bg-secondary-soft { background-color: rgba(108, 117, 125, 0.1); }
    .font-size-8 { font-size: 8px; }
    .avatar-sm { width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; }
</style>
