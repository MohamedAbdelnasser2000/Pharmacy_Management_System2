@model IMS.Models.UserSettingsViewModel
@{
    ViewData["Title"] = "إعدادات المستخدم";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 text-dark">إعدادات المستخدم</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">الرئيسية</a></li>
                    <li class="breadcrumb-item active">إعدادات المستخدم</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="row">
            <!-- Profile Information -->
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h5 class="card-title mb-0">
                            <i class="fas fa-user-edit"></i> تحديث البيانات الشخصية
                        </h5>
                    </div>
                    <div class="card-body">
                        <form asp-action="UpdateProfile" method="post">
                            @Html.AntiForgeryToken()
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                            <div class="form-group mb-3">
                                <label asp-for="UserName" class="control-label">
                                    <i class="fas fa-user"></i> اسم المستخدم
                                </label>
                                <input asp-for="UserName" class="form-control" placeholder="أدخل اسم المستخدم" />
                                <span asp-validation-for="UserName" class="text-danger"></span>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="FullName" class="control-label">
                                    <i class="fas fa-id-card"></i> الاسم الكامل
                                </label>
                                <input asp-for="FullName" class="form-control" placeholder="أدخل الاسم الكامل" />
                                <span asp-validation-for="FullName" class="text-danger"></span>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="Email" class="control-label">
                                    <i class="fas fa-envelope"></i> البريد الإلكتروني
                                </label>
                                <input asp-for="Email" class="form-control" placeholder="أدخل البريد الإلكتروني" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                            <div class="form-group text-end">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-save"></i> حفظ التغييرات
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Change Password -->
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header bg-warning text-dark">
                        <h5 class="card-title mb-0">
                            <i class="fas fa-key"></i> تغيير كلمة المرور
                        </h5>
                    </div>
                    <div class="card-body">
                        <form asp-action="ChangePassword" method="post">
                            @Html.AntiForgeryToken()

                            <div class="form-group mb-3">
                                <label asp-for="CurrentPassword" class="control-label">
                                    <i class="fas fa-lock"></i> كلمة المرور الحالية
                                </label>
                                <input asp-for="CurrentPassword" class="form-control" placeholder="أدخل كلمة المرور الحالية" />
                                <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="NewPassword" class="control-label">
                                    <i class="fas fa-lock"></i> كلمة المرور الجديدة
                                </label>
                                <input asp-for="NewPassword" class="form-control" placeholder="أدخل كلمة المرور الجديدة" />
                                <span asp-validation-for="NewPassword" class="text-danger"></span>
                                <small class="text-muted">يجب أن تكون 6 أحرف على الأقل</small>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="ConfirmPassword" class="control-label">
                                    <i class="fas fa-lock"></i> تأكيد كلمة المرور
                                </label>
                                <input asp-for="ConfirmPassword" class="form-control" placeholder="أعد إدخال كلمة المرور الجديدة" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                            </div>

                            <div class="form-group text-end">
                                <button type="submit" class="btn btn-warning">
                                    <i class="fas fa-key"></i> تغيير كلمة المرور
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- User Information Card -->
        <div class="row mt-4">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header bg-info text-white">
                        <h5 class="card-title mb-0">
                            <i class="fas fa-info-circle"></i> معلومات الحساب
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4">
                                <p><strong><i class="fas fa-user"></i> اسم المستخدم الحالي:</strong></p>
                                <p class="text-muted">@User.GetFullName()</p>
                            </div>
                            <div class="col-md-4">
                                <p><strong><i class="fas fa-shield-alt"></i> الدور:</strong></p>
                                <p class="text-muted">
                                    مرحباً، @User.GetFullName()!
                                    @if (User.IsInRole(RoleNamesConstants.Admin))
                                    {
                                        <span class="badge bg-danger">مدير النظام</span>
                                    }
                                    else if (User.IsInRole(RoleNamesConstants.Accountant))
                                    {
                                        <span class="badge bg-primary">محاسب</span>
                                    }
                                    else if (User.IsInRole(RoleNamesConstants.WarehouseStaff))
                                    {
                                        <span class="badge bg-success">موظف مستودع</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">مستخدم</span>
                                    }
                                </p>
                            </div>
                            <div class="col-md-4">
                                <p><strong><i class="fas fa-clock"></i> آخر تحديث:</strong></p>
                                <p class="text-muted">@IMS.AppClock.UtcNow.ToString("yyyy/MM/dd HH:mm")</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Security Tips -->
        <div class="row mt-4">
            <div class="col-md-12">
                <div class="alert alert-warning">
                    <h6><i class="fas fa-exclamation-triangle"></i> نصائح أمنية:</h6>
                    <ul class="mb-0">
                        <li>استخدم كلمة مرور قوية تحتوي على أحرف كبيرة وصغيرة وأرقام ورموز</li>
                        <li>لا تشارك كلمة المرور مع أي شخص</li>
                        <li>قم بتغيير كلمة المرور بشكل دوري</li>
                        <li>تأكد من تسجيل الخروج عند الانتهاء من العمل</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
