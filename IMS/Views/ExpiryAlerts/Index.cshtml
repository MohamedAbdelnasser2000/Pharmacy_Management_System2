@model IEnumerable<IMS.Models.ExpiryAlert>

@{
    ViewData["Title"] = "تنبيهات انتهاء الصلاحية";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0"><i class="fas fa-calendar-times text-warning"></i> تنبيهات انتهاء الصلاحية</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-start">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">الرئيسية</a></li>
                    <li class="breadcrumb-item active">تنبيهات الصلاحية</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-header">
                <div class="row">
                    <div class="col-md-8">
                        <form asp-action="Index" method="get" class="form-inline">
                            <div class="input-group">
                                <select name="alertStatus" class="form-control">
                                    <option value="">جميع الحالات</option>
                                    <option value="منتهي">منتهي</option>
                                    <option value="قريب من الانتهاء">قريب من الانتهاء</option>
                                    <option value="تحذير">تحذير</option>
                                </select>
                                <select name="isHandled" class="form-control ms-2">
                                    <option value="">الكل</option>
                                    <option value="false">لم تتم المعالجة</option>
                                    <option value="true">تمت المعالجة</option>
                                </select>
                                <button type="submit" class="btn btn-primary ms-2">
                                    <i class="fas fa-search"></i> بحث
                                </button>
                            </div>
                        </form>
                    </div>
                    <div class="col-md-4 text-start">
                        <a asp-action="GenerateAlerts" class="btn btn-warning">
                            <i class="fas fa-sync"></i> توليد تنبيهات تلقائية
                        </a>
                    </div>
                </div>
            </div>
            <div class="card-body">
                @if (Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped table-hover">
                            <thead class="table-primary">
                                <tr>
                                    <th>المنتج</th>
                                    <th>المستودع</th>
                                    <th>تاريخ الانتهاء</th>
                                    <th>الكمية</th>
                                    <th>الحالة</th>
                                    <th>تمت المعالجة</th>
                                    <th>الإجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var alert in Model)
                                {
                                    var rowClass = alert.AlertStatus == "منتهي" ? "table-danger" : 
                                                  alert.AlertStatus == "قريب من الانتهاء" ? "table-warning" : "";
                                    var badgeClass = alert.AlertStatus == "منتهي" ? "bg-danger" : 
                                                    alert.AlertStatus == "قريب من الانتهاء" ? "bg-warning" : "bg-info";
                                    <tr class="@rowClass">
                                        <td><strong>@alert.Product.Name</strong></td>
                                        <td>@alert.Warehouse?.Name</td>
                                        <td>@alert.ExpiryDate.ToString("yyyy-MM-dd")</td>
                                        <td><span class="badge bg-secondary">@alert.Quantity</span></td>
                                        <td><span class="badge @badgeClass">@alert.AlertStatus</span></td>
                                        <td>
                                            @if (alert.IsHandled)
                                            {
                                                <span class="badge bg-success"><i class="fas fa-check"></i> نعم</span>
                                                <br/><small>@alert.ActionTaken</small>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger"><i class="fas fa-times"></i> لا</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="btn-group">
                                                <a asp-action="Details" asp-route-id="@alert.Id" class="btn btn-sm btn-info">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@alert.Id" class="btn btn-sm btn-danger">
                                                    <i class="fas fa-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-success text-center">
                        <i class="fas fa-check-circle fa-2x mb-2"></i>
                        <p class="mb-0">لا توجد تنبيهات صلاحية حالياً. جميع المنتجات صالحة!</p>
                    </div>
                }
            </div>
            @if (Model.Any())
            {
                <div class="card-footer">
                    <span class="badge bg-danger me-2">منتهي: @Model.Count(a => a.AlertStatus == "منتهي")</span>
                    <span class="badge bg-warning me-2">قريب من الانتهاء: @Model.Count(a => a.AlertStatus == "قريب من الانتهاء")</span>
                    <span class="badge bg-info me-2">تحذير: @Model.Count(a => a.AlertStatus == "تحذير")</span>
                    <span class="badge bg-success me-2">تمت المعالجة: @Model.Count(a => a.IsHandled)</span>
                </div>
            }
        </div>
    </div>
</section>
