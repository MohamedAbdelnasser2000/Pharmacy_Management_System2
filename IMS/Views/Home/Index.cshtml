@model DashboardViewModel
@{
    ViewData["Title"] = "لوحة التحكم - نظام الصيدلية";
}

@if (User.IsInRole(RoleNamesConstants.Admin))
{
    <partial name="_AdminDashboard" model="Model" />
}
else if (User.IsInRole(RoleNamesConstants.Accountant))
{
    <partial name="_AccountantDashboard" model="Model" />
}
else if (User.IsInRole(RoleNamesConstants.WarehouseStaff))
{
    <partial name="_WarehouseDashboard" model="Model" />
}
else if (User.IsInRole(RoleNamesConstants.Pharmacist))
{
    <partial name="_PharmacistDashboard" model="Model" />
}
else if (User.IsInRole(RoleNamesConstants.Cashier))
{
    <partial name="_CashierDashboard" model="Model" />
}
else if (User.IsInRole(RoleNamesConstants.DataEntry))
{
    <partial name="_DataEntryDashboard" model="Model" />
}
else
{
    <div class="container-fluid py-5 text-center">
        <div class="glass-panel p-5 d-inline-block">
            <i class="fas fa-user-shield fa-4x text-muted mb-3"></i>
            <h3 class="fw-bold">وصول محدود</h3>
            <p class="text-muted">ليس لديك صلاحية لعرض لوحة التحكم الإدارية.</p>
            <a href="/" class="btn btn-premium btn-premium-primary">العودة للمتجر</a>
        </div>
    </div>
}
        </div>
    </div>
</section>

<style>
    .bg-soft-primary { background: rgba(79, 195, 247, 0.15); } /* Light Blue */
    .bg-soft-success { background: rgba(46, 139, 87, 0.1); } /* Medical Green */
    .bg-soft-warning { background: rgba(251, 191, 36, 0.1); }
    .bg-soft-danger { background: rgba(248, 113, 113, 0.1); }
    .text-success { color: var(--ims-primary) !important; }
    .text-primary { color: var(--ims-accent) !important; }
</style>
