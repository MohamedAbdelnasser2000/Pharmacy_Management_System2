@model DashboardViewModel

<div class="content-header mb-4">
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2 class="fw-bold mb-1">لوحة الصيدلي</h2>
                <p class="text-muted mb-0">مرحباً دكتور، تابع الروشتات وصرف الأدوية</p>
            </div>
            <div class="glass-panel px-3 py-2 text-primary fw-semibold small d-none d-md-block">
                <i class="fas fa-calendar-day me-2"></i> @IMS.AppClock.UtcNow.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("ar-EG"))
            </div>
        </div>
    </div>
</div>

<div class="container-fluid mb-5">
    <div class="row g-4">
        <div class="col-md-4">
            <a asp-controller="Prescriptions" asp-action="Create" class="info-card d-flex align-items-center text-decoration-none shadow-sm h-100 bg-primary text-white">
                <div class="info-card-icon icon-white p-3 me-3"><i class="fas fa-file-prescription fa-2x"></i></div>
                <div>
                    <span class="fw-bold d-block h5 mb-0">صرف روشتة جديدة</span>
                    <small class="opacity-75">ابدأ عملية صرف دواء الآن</small>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a asp-controller="DrugInteractions" asp-action="Index" class="info-card d-flex align-items-center text-decoration-none shadow-sm h-100 bg-info text-white">
                <div class="info-card-icon icon-white p-3 me-3"><i class="fas fa-shield-virus fa-2x"></i></div>
                <div>
                    <span class="fw-bold d-block h5 mb-0">فحص التفاعلات</span>
                    <small class="opacity-75">تحقق من سلامة الأدوية</small>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a asp-controller="Products" asp-action="Index" class="info-card d-flex align-items-center text-decoration-none shadow-sm h-100 bg-success text-white">
                <div class="info-card-icon icon-white p-3 me-3"><i class="fas fa-search-plus fa-2x"></i></div>
                <div>
                    <span class="fw-bold d-block h5 mb-0">بحث في المخزون</span>
                    <small class="opacity-75">تأكد من توفر الدواء</small>
                </div>
            </a>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="row g-4">
            <div class="col-lg-7">
                <div class="info-card h-100">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 class="fw-bold mb-0">آخر الروشتات المصروفة</h5>
                        <span class="badge bg-soft-primary text-primary px-3 py-2 rounded-pill">إجمالي اليوم: @Model.PendingOrders</span>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-borderless">
                            <thead>
                                <tr class="text-muted small">
                                    <th>رقم الروشتة</th>
                                    <th>المريض</th>
                                    <th>الحالة</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var order in Model.RecentOrders)
                                {
                                    <tr>
                                        <td class="fw-bold">#@order.Id</td>
                                        <td>@order.CustomerName</td>
                                        <td>
                                            <span class="badge @(order.Status == "Completed" ? "bg-soft-success text-success" : "bg-soft-warning text-warning") rounded-pill p-2">
                                                @order.Status
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="info-card h-100 bg-light border-0">
                    <h5 class="fw-bold mb-4 text-danger"><i class="fas fa-vial me-2"></i>تنبيهات دوائية هامة</h5>
                    <div class="alert alert-warning border-0 rounded-3 small">
                        تأكد دائماً من مراجعة تاريخ الصلاحية وسؤال المريض عن وجود أي حساسية.
                    </div>
                    <div class="p-3 bg-white rounded-3 shadow-sm mt-3">
                        <h6 class="fw-bold mb-2">أدوية تحت الحد الأدنى</h6>
                        @foreach (var item in Model.LowStockProducts.Take(5))
                        {
                            <div class="d-flex justify-content-between mb-1 small">
                                <span>@item.Label</span>
                                <span class="text-danger">@item.Value</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
