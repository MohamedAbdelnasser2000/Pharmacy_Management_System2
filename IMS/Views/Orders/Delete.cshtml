@model IMS.Models.Order
@{
    ViewData["Title"] = "إلغاء عملية البيع - الصيدلية";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0"><i class="fas fa-trash-alt text-danger"></i> إلغاء عملية البيع</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">الرئيسية</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">المبيعات</a></li>
                    <li class="breadcrumb-item active">إلغاء</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-gradient-danger text-white">
                <h5 class="card-title mb-0"><i class="fas fa-exclamation-triangle"></i> تأكيد إلغاء عملية البيع</h5>
            </div>
            <div class="card-body">
                <div class="alert alert-danger">
                    <i class="fas fa-exclamation-circle"></i>
                    <strong>تحذير:</strong> هل أنت متأكد من رغبتك في إلغاء عملية البيع التالية؟
                </div>
                <dl class="row">
                    <dt class="col-sm-3"><i class="fas fa-hashtag"></i> رقم الفاتورة:</dt>
                    <dd class="col-sm-9"><strong>#@Model.Id</strong></dd>

                    <dt class="col-sm-3"><i class="fas fa-user-injured"></i> العميل/المريض:</dt>
                    <dd class="col-sm-9">@Model.Customer?.Name</dd>

                    <dt class="col-sm-3"><i class="fas fa-calendar"></i> التاريخ:</dt>
                    <dd class="col-sm-9">@Model.OrderDate.ToString("yyyy/MM/dd")</dd>

                    <dt class="col-sm-3"><i class="fas fa-money-bill"></i> المبلغ الإجمالي:</dt>
                    <dd class="col-sm-9"><strong class="text-success">@Model.TotalAmount.ToString("C")</strong></dd>

                    <dt class="col-sm-3"><i class="fas fa-info-circle"></i> الحالة:</dt>
                    <dd class="col-sm-9"><span class="badge bg-info">@Model.Status</span></dd>
                </dl>

                @if (Model.OrderItems != null && Model.OrderItems.Any())
                {
                    <div class="alert alert-warning">
                        <i class="fas fa-pills"></i>
                        <strong>ملاحظة:</strong> هذه العملية تحتوي على @Model.OrderItems.Count من الأدوية. الإلغاء سيحذف جميع العناصر المرتبطة.
                    </div>
                }
            </div>
            <div class="card-footer text-end">
                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
                    <button type="submit" class="btn btn-danger">حذف</button>
                </form>
            </div>
        </div>
    </div>
</section>
