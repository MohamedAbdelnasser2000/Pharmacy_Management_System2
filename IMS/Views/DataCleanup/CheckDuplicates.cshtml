@{
    ViewData["Title"] = "فحص البيانات المكررة";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 text-dark">فحص وتنظيف البيانات المكررة</h1>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @{
            var hasDuplicates = (ViewBag.DuplicateOrderItems != null && ViewBag.DuplicateOrderItems.Count > 0) ||
                               (ViewBag.DuplicatePurchaseOrderItems != null && ViewBag.DuplicatePurchaseOrderItems.Count > 0);
        }

        @if (hasDuplicates)
        {
            <div class="card mb-4 border-danger">
                <div class="card-header bg-danger text-white">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-exclamation-circle"></i> إجراء سريع
                    </h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning mb-3">
                        <i class="fas fa-info-circle"></i>
                        <strong>تنبيه:</strong> تم العثور على بيانات مكررة في قاعدة البيانات. يمكنك حذف جميع البيانات المكررة دفعة واحدة.
                    </div>
                    <form asp-action="RemoveAllDuplicates" method="post" 
                          onsubmit="return confirm('⚠️ هل أنت متأكد من حذف جميع البيانات المكررة؟\n\nسيتم حذف:\n- البيانات المكررة من طلبات البيع\n- البيانات المكررة من أوامر الشراء\n\nسيتم الاحتفاظ بنسخة واحدة فقط من كل عنصر.');">
                        <button type="submit" class="btn btn-danger btn-lg">
                            <i class="fas fa-broom"></i> حذف جميع البيانات المكررة دفعة واحدة
                        </button>
                        <a asp-action="VerifyQueries" class="btn btn-info btn-lg ms-2">
                            <i class="fas fa-search"></i> التحقق من الاستعلامات
                        </a>
                    </form>
                </div>
            </div>
        }

        <div class="card mb-4">
            <div class="card-header bg-warning">
                <h5 class="card-title mb-0"><i class="fas fa-exclamation-triangle"></i> عناصر مكررة في طلبات البيع</h5>
            </div>
            <div class="card-body">
                @if (ViewBag.DuplicateOrderItems != null && ViewBag.DuplicateOrderItems.Count > 0)
                {
                    <div class="alert alert-danger">
                        <strong>تحذير!</strong> تم العثور على @ViewBag.DuplicateOrderItems.Count مجموعة من العناصر المكررة في طلبات البيع.
                    </div>
                    
                    <table class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>رقم الطلب</th>
                                <th>رقم المنتج</th>
                                <th>عدد التكرارات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in ViewBag.DuplicateOrderItems)
                            {
                                <tr>
                                    <td>@item.OrderId</td>
                                    <td>@item.ProductId</td>
                                    <td><span class="badge bg-danger">@item.Count</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <form asp-action="RemoveDuplicateOrderItems" method="post" onsubmit="return confirm('هل أنت متأكد من حذف العناصر المكررة؟ سيتم الاحتفاظ بنسخة واحدة فقط من كل عنصر.');">
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-trash"></i> حذف العناصر المكررة من طلبات البيع
                        </button>
                    </form>
                }
                else
                {
                    <div class="alert alert-success">
                        <i class="fas fa-check-circle"></i> لا توجد عناصر مكررة في طلبات البيع
                    </div>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header bg-warning">
                <h5 class="card-title mb-0"><i class="fas fa-exclamation-triangle"></i> عناصر مكررة في أوامر الشراء</h5>
            </div>
            <div class="card-body">
                @if (ViewBag.DuplicatePurchaseOrderItems != null && ViewBag.DuplicatePurchaseOrderItems.Count > 0)
                {
                    <div class="alert alert-danger">
                        <strong>تحذير!</strong> تم العثور على @ViewBag.DuplicatePurchaseOrderItems.Count مجموعة من العناصر المكررة في أوامر الشراء.
                    </div>
                    
                    <table class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>رقم أمر الشراء</th>
                                <th>رقم المنتج</th>
                                <th>عدد التكرارات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in ViewBag.DuplicatePurchaseOrderItems)
                            {
                                <tr>
                                    <td>@item.PurchaseOrderId</td>
                                    <td>@item.ProductId</td>
                                    <td><span class="badge bg-danger">@item.Count</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <form asp-action="RemoveDuplicatePurchaseOrderItems" method="post" onsubmit="return confirm('هل أنت متأكد من حذف العناصر المكررة؟ سيتم الاحتفاظ بنسخة واحدة فقط من كل عنصر.');">
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-trash"></i> حذف العناصر المكررة من أوامر الشراء
                        </button>
                    </form>
                }
                else
                {
                    <div class="alert alert-success">
                        <i class="fas fa-check-circle"></i> لا توجد عناصر مكررة في أوامر الشراء
                    </div>
                }
            </div>
        </div>

        <div class="mt-3">
            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> العودة للرئيسية
            </a>
        </div>
    </div>
</section>
