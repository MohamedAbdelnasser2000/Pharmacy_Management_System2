@model IEnumerable<IMS.Models.StockMovement>

@{
    ViewData["Title"] = "سجل حركات المخزون";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 text-dark">
                    <i class="bi bi-clock-history"></i>
                    سجل حركات المخزون
                </h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">الرئيسية</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">مسح الباركود</a></li>
                    <li class="breadcrumb-item active">سجل الحركات</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <!-- Filter Section -->
        <div class="card mb-3">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="bi bi-funnel"></i>
                    تصفية النتائج
                </h5>
            </div>
            <div class="card-body">
                <form method="get" asp-action="MovementHistory">
                    <div class="row">
                        <div class="col-md-3">
                            <label class="form-label">المنتج</label>
                            <select name="productId" class="form-select" asp-items="ViewBag.ProductId">
                                <option value="">جميع المنتجات</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">المستودع</label>
                            <select name="warehouseId" class="form-select" asp-items="ViewBag.WarehouseId">
                                <option value="">جميع المستودعات</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">من تاريخ</label>
                            <input type="date" name="fromDate" class="form-control" value="@ViewBag.FromDate">
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">إلى تاريخ</label>
                            <input type="date" name="toDate" class="form-control" value="@ViewBag.ToDate">
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="bi bi-search"></i>
                                بحث
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Results Section -->
        <div class="card">
            <div class="card-header">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bi bi-list-ul"></i>
                        النتائج (@Model.Count() حركة)
                    </h5>
                    <a asp-action="Index" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-upc-scan"></i>
                        العودة لمسح الباركود
                    </a>
                </div>
            </div>
            <div class="card-body">
                @if (Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>التاريخ والوقت</th>
                                    <th>المنتج</th>
                                    <th>المستودع</th>
                                    <th>نوع الحركة</th>
                                    <th>الكمية</th>
                                    <th>السبب</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var movement in Model)
                                {
                                    <tr>
                                        <td>
                                            <i class="bi bi-calendar3"></i>
                                            @movement.MovementDate.ToString("dd/MM/yyyy HH:mm")
                                        </td>
                                        <td>
                                            <strong>@movement.Product?.Name</strong>
                                            @if (!string.IsNullOrEmpty(movement.Product?.Code))
                                            {
                                                <br><small class="text-muted">كود: @movement.Product.Code</small>
                                            }
                                        </td>
                                        <td>
                                            <i class="bi bi-building"></i>
                                            @movement.Warehouse?.Name
                                        </td>
                                        <td>
                                            @if (movement.MovementType == "إدخال")
                                            {
                                                <span class="badge bg-success">
                                                    <i class="bi bi-box-arrow-in-down"></i>
                                                    إدخال
                                                </span>
                                            }
                                            else if (movement.MovementType == "إخراج")
                                            {
                                                <span class="badge bg-danger">
                                                    <i class="bi bi-box-arrow-up"></i>
                                                    إخراج
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-info">@movement.MovementType</span>
                                            }
                                        </td>
                                        <td>
                                            <strong>@movement.Quantity</strong>
                                        </td>
                                        <td>
                                            @(movement.Reason ?? "-")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (Model.Count() >= 100)
                    {
                        <div class="alert alert-info mt-3">
                            <i class="bi bi-info-circle"></i>
                            يتم عرض آخر 100 حركة فقط. استخدم التصفية للحصول على نتائج أكثر تحديداً.
                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle"></i>
                        لا توجد حركات مخزون مطابقة للبحث
                    </div>
                }
            </div>
        </div>

        <!-- Summary Statistics -->
        @if (Model.Any())
        {
            var totalIn = Model.Where(m => m.MovementType == "إدخال").Sum(m => m.Quantity);
            var totalOut = Model.Where(m => m.MovementType == "إخراج").Sum(m => m.Quantity);
            var netMovement = totalIn - totalOut;

            <div class="row mt-3">
                <div class="col-md-4">
                    <div class="card bg-success text-white">
                        <div class="card-body">
                            <h6>إجمالي الإدخال</h6>
                            <h3>@totalIn</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card bg-danger text-white">
                        <div class="card-body">
                            <h6>إجمالي الإخراج</h6>
                            <h3>@totalOut</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card bg-info text-white">
                        <div class="card-body">
                            <h6>صافي الحركة</h6>
                            <h3>@netMovement</h3>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>
