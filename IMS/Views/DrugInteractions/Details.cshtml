@model IMS.Models.DrugInteraction

@{
    ViewData["Title"] = "تفاصيل التفاعل الدوائي";
    var badgeClass = Model.SeverityLevel == "خطير" ? "bg-danger" : 
                    Model.SeverityLevel == "متوسط" ? "bg-warning" : "bg-info";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0"><i class="fas fa-exclamation-circle text-danger"></i> تفاصيل التفاعل الدوائي</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-start">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">الرئيسية</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">التفاعلات الدوائية</a></li>
                    <li class="breadcrumb-item active">التفاصيل</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <div class="card card-danger">
                    <div class="card-header">
                        <h3 class="card-title"><i class="fas fa-info-circle"></i> معلومات التفاعل</h3>
                        <div class="card-tools">
                            <span class="badge @badgeClass">@Model.SeverityLevel</span>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="info-box bg-light">
                                    <span class="info-box-icon bg-primary"><i class="fas fa-pills"></i></span>
                                    <div class="info-box-content">
                                        <span class="info-box-text">الدواء الأول</span>
                                        <span class="info-box-number">@Model.Product1.Name</span>
                                        @if (!string.IsNullOrEmpty(Model.Product1.ScientificName))
                                        {
                                            <small class="text-muted">@Model.Product1.ScientificName</small>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="info-box bg-light">
                                    <span class="info-box-icon bg-primary"><i class="fas fa-pills"></i></span>
                                    <div class="info-box-content">
                                        <span class="info-box-text">الدواء الثاني</span>
                                        <span class="info-box-number">@Model.Product2.Name</span>
                                        @if (!string.IsNullOrEmpty(Model.Product2.ScientificName))
                                        {
                                            <small class="text-muted">@Model.Product2.ScientificName</small>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <dl class="row mt-3">
                            <dt class="col-sm-3"><i class="fas fa-exclamation-triangle"></i> مستوى الخطورة:</dt>
                            <dd class="col-sm-9">
                                <h4><span class="badge @badgeClass">@Model.SeverityLevel</span></h4>
                            </dd>

                            <dt class="col-sm-3"><i class="fas fa-file-medical"></i> وصف التفاعل:</dt>
                            <dd class="col-sm-9">
                                <div class="alert alert-danger">
                                    <strong>@Model.InteractionDescription</strong>
                                </div>
                            </dd>

                            @if (!string.IsNullOrEmpty(Model.Recommendations))
                            {
                                <dt class="col-sm-3"><i class="fas fa-lightbulb"></i> التوصيات:</dt>
                                <dd class="col-sm-9">
                                    <div class="alert alert-warning">
                                        @Model.Recommendations
                                    </div>
                                </dd>
                            }

                            <dt class="col-sm-3"><i class="fas fa-toggle-on"></i> الحالة:</dt>
                            <dd class="col-sm-9">
                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success"><i class="fas fa-check"></i> نشط</span>
                                    <small class="text-muted">- سيظهر في التحذيرات</small>
                                }
                                else
                                {
                                    <span class="badge bg-secondary"><i class="fas fa-times"></i> غير نشط</span>
                                }
                            </dd>

                            <dt class="col-sm-3"><i class="fas fa-calendar"></i> تاريخ الإضافة:</dt>
                            <dd class="col-sm-9">@Model.CreatedDate.ToString("yyyy-MM-dd hh:mm tt")</dd>
                        </dl>
                    </div>
                    <div class="card-footer">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                            <i class="fas fa-edit"></i> تعديل
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                            <i class="fas fa-trash"></i> حذف
                        </a>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-right"></i> رجوع للقائمة
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
